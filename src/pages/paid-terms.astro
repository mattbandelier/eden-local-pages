---
import BaseLayout from "../layouts/BaseLayout.astro";
import { canonicalUrl } from "../lib/urls";

const canonical = canonicalUrl("/paid-terms");
---

<BaseLayout
	title="Terms | Eden Health Club"
	description="Terms of use for Eden Health Club paid landing pages."
	canonicalUrl={canonical}
	noindex={true}
>
	<header class="border-b border-white/10 bg-eden-forest text-white">
		<div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
			<span class="font-semibold">Eden Health Club</span>
			<a href="tel:+17206057678" class="text-sm font-semibold">720-605-7678</a>
		</div>
	</header>
	<main class="min-h-[70vh] bg-white px-6 py-12 text-slate-700 sm:py-16">
		<article class="mx-auto max-w-4xl">
			<p class="text-sm font-semibold uppercase text-eden-green">Eden Wellness, LLC</p>
			<h1 class="mt-3 text-4xl font-semibold text-eden-navy">Terms of Use</h1>
			<div class="mt-8 space-y-8 leading-7">
				<section>
					<h2 class="text-2xl font-semibold text-eden-navy">Website and email communications</h2>
					<p class="mt-3">
						Communications through our websites or by email are not encrypted and are not necessarily secure. Use of the internet or email is for your convenience, and by using them you assume the risk of unauthorized use.
					</p>
					<p class="mt-3">
						By submitting a form, you agree to hold Eden Wellness, LLC, its providers, and affiliates harmless from hacking or other unauthorized use of your personal information by outside parties.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-eden-navy">SMS disclosure</h2>
					<p class="mt-3">
						SMS may be used for appointment reminders, marketing messages, and communication with the office. Message frequency may vary. Message and data rates may apply. Reply STOP at any time to opt out or HELP for assistance.
					</p>
				</section>

				<section>
					<h2 class="text-2xl font-semibold text-eden-navy">Contact</h2>
					<p class="mt-3">
						For immediate assistance, contact Eden Wellness, LLC at
						<a href="tel:+17206057678" class="font-semibold text-eden-green">720-605-7678</a>.
					</p>
					<p class="mt-3">
						5990 S University Blvd<br />
						Greenwood Village, CO 80121
					</p>
				</section>
			</div>
		</article>
	</main>
	<footer class="bg-eden-forest px-6 py-8 text-sm text-white/72">
		<div class="mx-auto flex max-w-4xl gap-4">
			<a href="/paid-privacy/" class="font-semibold text-white">Privacy</a>
			<a href="/paid-terms/" class="font-semibold text-white">Terms</a>
		</div>
	</footer>
</BaseLayout>
