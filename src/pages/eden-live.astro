---
import EdenLiveLayout from "../layouts/EdenLiveLayout.astro";
import { faqs, itinerary, stats } from "../data/eden-live-content";
const appStoreUrl = "https://apps.apple.com/us/app/eden-look-feel-perform/id6788305713";
const appStoreBadge = "https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83";
const playStoreUrl = "https://play.google.com/store/apps/details?id=com.edenhealthclubs.fit.own";
const playStoreBadge = "https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png";
const freeSignupUrl = "https://fit.edenhealthclubs.com/users/sign_up";
const workoutScenes = [
  { image: "/assets/eden-fitness-functional-strength.jpg", alt: "Eden Functional Strength workout with Coach Monica", label: "Strength", title: "Functional Strength", detail: "A coached workout from Eden's current video library." },
  { image: "/assets/eden-fitness-foam-roller.jpg", alt: "Eden Foam Roller Recovery workout with Coach Lyndsay", label: "Recovery", title: "Foam Roller Recovery", detail: "Make room for a short recovery session." },
  { image: "/assets/eden-fitness-upper-body.jpg", alt: "Eden Upper Body Strength workout tile", label: "Upper body", title: "Upper Body Strength", detail: "Pick a workout that fits your day." },
  { image: "/assets/eden-fitness-pilates-arms.jpg", alt: "Eden Pilates Arms workout with Coach Monica", label: "Pilates", title: "Pilates Arms", detail: "A guided session with light dumbbells." },
  { image: "/assets/eden-fitness-cardio.jpg", alt: "Eden bodyweight cardio workout with Coach Spenser", label: "Cardio", title: "Bodyweight Cardio", detail: "Move with Coach Spenser, wherever you are." },
  { image: "/assets/eden-fitness-restorative.jpg", alt: "Eden restorative recovery workout with Coach Lyndsay", label: "Recovery", title: "Restorative Recovery", detail: "Slow down with a guided recovery session." },
];
---
<EdenLiveLayout>
  <header class="site-nav">
    <a class="brand" href="#top" aria-label="Eden fitness app home">
      <img src="/assets/eden-live-logo-white.png" width="180" height="64" alt="Eden Health Club" />
      <span>FITNESS APP</span>
    </a>
    <div class="nav-actions">
      <a class="member-link" href="https://fit.edenhealthclubs.com" rel="external">Member login</a>
      <a class="button button-small" href="#get-app">Get the app</a>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-image" src="/assets/eden-fitness-class-polished.jpg" width="1536" height="1024" alt="An Eden fitness class in the club" loading="eager" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">The Eden fitness app · Free now</p>
          <h1 id="hero-title">Your workout, wherever life takes you.</h1>
          <p class="hero-lede">Press play on Eden workouts whenever it works for you. Join live coached sessions when you want to move together.</p>
          <ul class="hero-points" aria-label="Fitness app highlights">
            <li>On-demand workouts</li>
            <li>Live coached sessions</li>
            <li>Free to join right now</li>
          </ul>
          <div class="hero-actions">
            <a class="button" href={freeSignupUrl} data-app-cta="signup">Create Your Free Account <span aria-hidden="true">→</span></a>
            <a class="store-link" href={appStoreUrl} data-app-cta="ios" target="_blank" rel="noopener noreferrer" aria-label="Download the Eden app on the App Store"><img src={appStoreBadge} width="150" height="50" alt="Download on the App Store" /></a>
            <a class="store-link play-store-link" href={playStoreUrl} data-app-cta="android" target="_blank" rel="noopener noreferrer" aria-label="Get the Eden fitness app on Google Play"><img src={playStoreBadge} width="170" height="51" alt="Get it on Google Play" /></a>
          </div>
          <p class="download-note">Free access is available now. Create an account, then open the app or train on the web.</p>
        </div>
      </div>
    </section>

    <section class="signup-section" id="get-app" aria-labelledby="join-title">
      <div class="signup-intro">
        <p class="kicker">Real Eden coaches</p>
        <h2 id="join-title">Coached by Eden. Ready when you are.</h2>
        <p>See the real coaches behind Eden's on-demand workouts. Pick a session that fits your day, press play, and move with us wherever you are.</p>
        <div class="signup-benefits"><span>Real coaches</span><span>On-demand workouts</span><span>Free to join now</span></div>
        <div class="signup-actions"><a class="button" href={freeSignupUrl} data-app-cta="signup">Start Your Free Workout <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="coach-reel">
        <video autoplay muted loop playsinline preload="metadata" poster="/assets/eden-coaches-on-demand-poster.jpg" aria-label="Preview of real Eden coaches leading on-demand workouts">
          <source src="/assets/eden-coaches-on-demand-reel.mp4" type="video/mp4" />
        </video>
        <img class="motion-poster" src="/assets/eden-coaches-on-demand-poster.jpg" width="1280" height="720" alt="An Eden coach leading an on-demand workout" loading="lazy" />
      </div>
    </section>

    <section class="stat-strip" aria-label="Eden fitness app at a glance">
      {stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
    </section>

    <section class="app-showcase section-pad" aria-labelledby="app-title">
      <div class="app-showcase-copy">
        <p class="kicker">Your studio, in your pocket</p>
        <h2 id="app-title">Find a workout that fits today.</h2>
        <p>At home, on the road, or between everything else: press play when you have time. And when you want company, join a live class with an Eden coach.</p>
        <a class="button" href={freeSignupUrl} data-app-cta="signup">Join Free <span aria-hidden="true">→</span></a>
      </div>
      <div class="app-device"><img src="/assets/eden-on-demand-functional-strength.jpg" width="1920" height="1080" loading="lazy" alt="An Eden on-demand functional strength workout in progress" /></div>
    </section>

    <section class="workout-gallery section-pad" aria-labelledby="gallery-title">
      <div class="gallery-heading">
        <div><p class="kicker">A workout for your day</p><h2 id="gallery-title">Start wherever you are.</h2></div>
        <div class="gallery-controls" aria-label="Workout gallery controls"><button type="button" data-gallery-prev aria-label="Previous workout">←</button><button type="button" data-gallery-next aria-label="Next workout">→</button></div>
      </div>
      <div class="gallery-track" data-gallery-track tabindex="0" aria-label="Ways to work out with Eden">
        {workoutScenes.map((scene) => <article class="gallery-item"><img src={scene.image} alt={scene.alt} loading="lazy" /><div class="gallery-caption"><span>{scene.label}</span><h3>{scene.title}</h3><p>{scene.detail}</p></div></article>)}
      </div>
    </section>

    <section class="comparison section-pad">
      <div class="section-heading split-heading">
        <div><p class="kicker">More than a workout library</p><h2>Move your way. Feel part of something.</h2></div>
        <p>On-demand freedom meets familiar live coaches and a real Eden Health Club in Greenwood Village. Start wherever you are; connect with more support when you need it.</p>
      </div>
      <div class="value-grid">
        <article><span>01</span><h3>Press play anywhere</h3><p>Make a workout fit your day, not the other way around. Choose from Eden's current on-demand sessions.</p></article>
        <article><span>02</span><h3>Show up live</h3><p>Check the schedule for coached sessions and real-time energy.</p></article>
        <article><span>03</span><h3>Go beyond the app</h3><p>Connect your routine to Eden's fitness, performance, and wellness experience in Greenwood Village.</p></article>
      </div>
    </section>

    <section class="week section-pad" aria-labelledby="week-title">
      <div class="section-heading"><p class="kicker">Find your rhythm</p><h2 id="week-title">Start small. Keep moving.</h2><p>Join live or choose a workout on demand. There is no countdown on your free access right now.</p></div>
      <div class="itinerary">
        {itinerary.map((item, index) => <article class:list={["day", index === 0 && "day-featured"]}><span>{item.day}</span><h3>{item.title}</h3><p>{item.detail}</p></article>)}
      </div>
    </section>

    <section class="coming-next section-pad" aria-labelledby="next-title">
      <p class="kicker">Coming next</p>
      <h2 id="next-title">More ways to train with Eden.</h2>
      <p>An exercise library and focused programs are in development. Programs such as HIIT Level One and GLP-1 muscle preservation will be separate purchases when available.</p>
    </section>

    <section class="trust section-pad" aria-labelledby="trust-title">
      <div class="trust-photo"><img src="/assets/eden-health-club-reception.webp" alt="Inside Eden Health Club" loading="lazy" /></div>
      <div class="trust-intro"><p class="kicker">More than a screen</p><h2 id="trust-title">A real club behind the app.</h2><p>Train wherever you are, knowing Eden has a real home in Greenwood Village. Live classes connect you with coaches, while the club offers more ways to pursue your goals when you are ready.</p><p class="clinical-note">In-club and clinical services are separate from the free fitness app.</p></div>
    </section>

    <section class="faq section-pad" aria-labelledby="faq-title">
      <div class="section-heading"><p class="kicker">The details</p><h2 id="faq-title">Questions, answered.</h2></div>
      <div class="faq-list">{faqs.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
    </section>

    <section class="final-cta">
      <div><p class="kicker">Free to join now</p><h2>Start where you are. We will meet you there.</h2><p>Create your Eden fitness account and move on your own time.</p></div>
      <a class="button button-light" href={freeSignupUrl} data-app-cta="signup">Join Free <span aria-hidden="true">→</span></a>
    </section>
  </main>

  <footer>
    <a class="brand footer-brand" href="#top"><img src="/assets/eden-live-logo-white.png" width="180" height="64" alt="Eden Health Club" /><span>FITNESS APP</span></a>
    <div><p>Eden Wellness LLC</p><p>Greenwood Village, Colorado</p></div>
    <div class="footer-links"><a href="https://edenhealthclubs.com/privacy-policy/">Privacy</a><a href="https://edenhealthclubs.com/terms-and-conditions/">Terms</a><a href="mailto:care@edenhealthclubs.com">care@edenhealthclubs.com</a></div>
  </footer>

  <script>
    const gallery = document.querySelector("[data-gallery-track]");
    document.querySelector("[data-gallery-prev]")?.addEventListener("click", () => gallery?.scrollBy({ left: -(gallery?.clientWidth || 0) * .85, behavior: "smooth" }));
    document.querySelector("[data-gallery-next]")?.addEventListener("click", () => gallery?.scrollBy({ left: (gallery?.clientWidth || 0) * .85, behavior: "smooth" }));
    const clickParams = new URLSearchParams(window.location.search);
    document.querySelectorAll<HTMLAnchorElement>('[data-app-cta]').forEach((link) => {
      if (link.dataset.appCta === 'signup') {
        const url = new URL(link.href);
        for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'gclid', 'gbraid', 'wbraid', 'fbclid']) {
          const value = clickParams.get(key);
          if (value) url.searchParams.set(key, value);
        }
        link.href = url.toString();
      }
      link.addEventListener('click', () => {
        const event = link.dataset.appCta === 'ios' ? 'fitness_app_ios_click' : link.dataset.appCta === 'android' ? 'fitness_app_android_click' : 'fitness_app_signup_click';
        const trackedWindow = window as typeof window & { dataLayer?: Array<Record<string, unknown>> };
        trackedWindow.dataLayer = trackedWindow.dataLayer || [];
        trackedWindow.dataLayer.push({ event });
      });
    });
  </script>
</EdenLiveLayout>
