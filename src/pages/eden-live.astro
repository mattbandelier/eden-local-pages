---
import EdenLiveLayout from "../layouts/EdenLiveLayout.astro";
import { faqs, itinerary, providers, stats } from "../data/eden-live-content";
import { Image } from "astro:assets";
import heroImage from "../assets/eden-live-performance-floor.jpg";

const states = ["AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY","DC"];
---
<EdenLiveLayout>
  <header class="site-nav">
    <a class="brand" href="#top" aria-label="Eden Live home">
      <img src="/assets/eden-live-logo-white.png" width="180" height="64" alt="Eden Health Club" />
      <span>LIVE</span>
    </a>
    <div class="nav-actions">
      <a class="member-link" href="https://fit.edenhealthclubs.com" rel="external">Member login</a>
      <a class="button button-small" href="#trial">Start Free Trial</a>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <Image class="hero-image" src={heroImage} width={724} height={904} alt="The strength training floor at Eden Health Club" format="webp" quality={68} loading="eager" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Seven days. No card. Start anywhere.</p>
          <h1 id="hero-title">Live workouts. Real coaches. Real care.</h1>
          <p class="hero-lede">A virtual fitness studio built around your whole health, with live weekday classes and workouts ready whenever you are.</p>
          <ul class="hero-points" aria-label="Trial benefits">
            <li>5 live coached classes every week</li>
            <li>100+ workouts on demand</li>
            <li>Free for 7 days, no credit card</li>
          </ul>
        </div>

        <div class="trial-panel" id="trial">
          <div class="form-intro">
            <p class="kicker">Your free week starts here</p>
            <h2>Create your Eden account</h2>
            <p>No credit card required.</p>
          </div>
          <form data-trial-form novalidate>
            <div class="name-row">
              <label><span>First name</span><input name="first_name" autocomplete="given-name" required /></label>
              <label><span>Last name</span><input name="last_name" autocomplete="family-name" required /></label>
            </div>
            <label><span>Email</span><input name="email" type="email" autocomplete="email" inputmode="email" required /></label>
            <div class="phone-row">
              <label><span>Mobile phone</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(555) 555-5555" pattern="[0-9()+ .-]{10,}" required /></label>
              <label><span>State</span><select name="state" autocomplete="address-level1" required><option value="">Select</option>{states.map((state) => <option value={state}>{state}</option>)}</select></label>
            </div>
            <button class="button form-submit" type="submit">Start My Free Trial <span aria-hidden="true">→</span></button>
            <p class="form-note">By continuing, you agree to receive account and trial messages from Eden. Message and data rates may apply.</p>
            <p class="form-status" data-form-status aria-live="polite"></p>
          </form>
          <div class="thank-you" data-thank-you hidden tabindex="-1">
            <p class="kicker">You are in</p>
            <h2>Your free week is ready.</h2>
            <p>Check your email and phone for the next step to activate your Eden account.</p>
            <a class="button" href="https://fit.edenhealthclubs.com">Open Eden Live</a>
          </div>
        </div>
      </div>
    </section>

    <section class="stat-strip" aria-label="Eden Live at a glance">
      {stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
    </section>

    <section class="comparison section-pad">
      <div class="section-heading split-heading">
        <div><p class="kicker">Not another fitness app</p><h2>Your workout can know the rest of you.</h2></div>
        <p>Most platforms stop at movement. Eden connects a coach-led fitness habit to a trusted health and wellness team, all within one relationship.</p>
      </div>
      <div class="comparison-table" role="table" aria-label="Eden Live compared with fitness apps">
        <div class="comparison-row comparison-head" role="row"><span role="columnheader">What matters</span><span role="columnheader">Typical apps</span><span role="columnheader">Eden Live</span></div>
        <div class="comparison-row" role="row"><span role="cell">Live, familiar coaching</span><span role="cell">Sometimes</span><strong role="cell">Every weekday</strong></div>
        <div class="comparison-row" role="row"><span role="cell">On-demand training</span><span role="cell">Yes</span><strong role="cell">Yes, built around real members</strong></div>
        <div class="comparison-row" role="row"><span role="cell">Provider-backed education</span><span role="cell">No</span><strong role="cell">Built into the experience</strong></div>
        <div class="comparison-row" role="row"><span role="cell">In-person path</span><span role="cell">No</span><strong role="cell">Eden Health Club</strong></div>
        <div class="comparison-row" role="row"><span role="cell">Cost to try</span><span role="cell">Card required</span><strong role="cell">$0, no card</strong></div>
      </div>
    </section>

    <section class="week section-pad" aria-labelledby="week-title">
      <div class="section-heading"><p class="kicker">Your first week</p><h2 id="week-title">Seven days to find your rhythm.</h2><p>A useful week, not a tour. Join live, train on demand, and experience the full platform.</p></div>
      <div class="itinerary">
        {itinerary.map((item, index) => <article class:list={["day", index === 0 && "day-featured"]}><span>{item.day}</span><h3>{item.title}</h3><p>{item.detail}</p></article>)}
      </div>
    </section>

    <section class="trust section-pad" aria-labelledby="trust-title">
      <div class="trust-intro"><p class="kicker">Fitness, with a care team behind it</p><h2 id="trust-title">Built by people who see the whole picture.</h2><p>Eden Live gives members credible, practical education alongside training. Christina, Shannon, and Beth bring the perspective of Eden's medical team to the experience.</p><p class="clinical-note">Clinical services are separate from fitness membership and depend on eligibility, licensure, and provider evaluation.</p></div>
      <div class="providers">
        {providers.map((provider) => <article class="provider"><div class="provider-mark" aria-hidden="true">{provider.initials}</div><div><h3>{provider.name}</h3><p>{provider.role}</p></div></article>)}
      </div>
    </section>

    <section class="faq section-pad" aria-labelledby="faq-title">
      <div class="section-heading"><p class="kicker">The details</p><h2 id="faq-title">Questions, answered.</h2></div>
      <div class="faq-list">{faqs.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
    </section>

    <section class="final-cta">
      <div><p class="kicker">Your first week is on us</p><h2>Start where you are. We will meet you there.</h2><p>Seven days of Eden Live, no credit card required.</p></div>
      <a class="button button-light" href="#trial">Start My Free Trial <span aria-hidden="true">→</span></a>
    </section>
  </main>

  <footer>
    <a class="brand footer-brand" href="#top"><img src="/assets/eden-live-logo-white.png" width="180" height="64" alt="Eden Health Club" /><span>LIVE</span></a>
    <div><p>Eden Wellness LLC</p><p>Greenwood Village, Colorado</p></div>
    <div class="footer-links"><a href="https://edenhealthclubs.com/privacy-policy/">Privacy</a><a href="https://edenhealthclubs.com/terms-and-conditions/">Terms</a><a href="mailto:care@edenhealthclubs.com">care@edenhealthclubs.com</a></div>
  </footer>

  <script>
    const form = document.querySelector("[data-trial-form]");
    const status = document.querySelector("[data-form-status]");
    const thankYou = document.querySelector("[data-thank-you]");
    const params = new URLSearchParams(window.location.search);
    const utmKeys = ["utm_source", "utm_medium", "utm_campaign"];
    const storageKey = "eden_live_utm";
    let saved: Record<string, string> = {};
    try { saved = JSON.parse(localStorage.getItem(storageKey) || "{}"); } catch {}
    const attribution = Object.fromEntries(utmKeys.map((key) => [key, params.get(key) || saved[key] || ""]));
    if (utmKeys.some((key) => params.get(key))) {
      try { localStorage.setItem(storageKey, JSON.stringify(attribution)); } catch {}
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const button = form.querySelector("button[type='submit']");
      const payload = { ...Object.fromEntries(new FormData(form)), ...attribution, submitted_at: new Date().toISOString() };
      if (button instanceof HTMLButtonElement) { button.disabled = true; button.textContent = "Starting your trial..."; }
      if (status) status.textContent = "Creating your Eden trial...";

      try {
        const response = await fetch("/api/trial/", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "We could not start your trial.");
        form.hidden = true;
        if (thankYou instanceof HTMLElement) { thankYou.hidden = false; thankYou.focus(); }
        const trackingWindow = window as typeof window & {
          dataLayer?: Array<Record<string, unknown>>;
          fbq?: (...args: unknown[]) => void;
          gtag?: (...args: unknown[]) => void;
        };
        trackingWindow.dataLayer = trackingWindow.dataLayer || [];
        trackingWindow.dataLayer.push({ event: "lead_submit", form_name: "eden_live_trial" });
        trackingWindow.fbq?.("track", "Lead");
        trackingWindow.gtag?.("event", "generate_lead", { event_category: "Eden Live", value: 0, currency: "USD" });
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : "Please try again or call 720-605-7678.";
      } finally {
        if (button instanceof HTMLButtonElement) { button.disabled = false; button.innerHTML = "Start My Free Trial <span aria-hidden='true'>→</span>"; }
      }
    });
  </script>
</EdenLiveLayout>
