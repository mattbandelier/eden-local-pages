---
import FAQAccordion from "../../components/content/FAQAccordion.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { JsonLd } from "../../lib/schema-org";

const canonical = "https://edenhealthclubs.com/medical-spa-greenwood-village/";
const title = "Medical Spa in Greenwood Village, CO | Eden Health Club";
const description =
	"Visit Eden Health Club, a medical spa and wellness center at 5990 S University Blvd in Greenwood Village. Explore aesthetics, IV therapy, recovery, fitness, and provider-guided care.";
const bookingUrl =
	"https://booking.edenhealthclubs.com/webstoreNew/services/a1fda69e-77f9-4077-bb8a-3b06349b6af3?utm_source=organic&utm_medium=location_page&utm_campaign=greenwood_village_med_spa";
const directionsUrl =
	"https://www.google.com/maps/dir/?api=1&destination=Eden%20Health%20Club%2C%205990%20S%20University%20Blvd%2C%20Greenwood%20Village%2C%20CO%2080121";

const services = [
	{
		name: "Aesthetics & skin care",
		body: "Explore aesthetic consultations, injectables, skin rejuvenation, and microneedling with a plan built around your goals.",
		href: "https://edenhealthclubs.com/skin-rejuvenation/",
	},
	{
		name: "IV therapy & recovery",
		body: "Support hydration, recovery, and wellness with in-person IV therapy and recovery options at the Greenwood Village location.",
		href: "https://edenhealthclubs.com/wellness-recovery/iv-therapy/",
	},
	{
		name: "Hormone & wellness care",
		body: "Start with a provider-guided conversation about hormone care, wellness goals, and the next appropriate step.",
		href: "https://edenhealthclubs.com/hormone-replacement-therapy/",
	},
	{
		name: "Medical weight management",
		body: "Discuss medical weight-management options and a plan designed around your individual history and goals.",
		href: "https://edenhealthclubs.com/functional-medicine/medical-weight-loss/",
	},
];

const faqs = [
	{
		question: "Where is Eden Health Club located?",
		answer:
			"Eden Health Club is located at 5990 S University Blvd in Greenwood Village, Colorado 80121, near the Denver Tech Center.",
	},
	{
		question: "What services are available at the Greenwood Village location?",
		answer:
			"Eden brings aesthetics, skin care, IV therapy, recovery, fitness, medical weight management, and provider-guided wellness care together at one in-person location. Availability and appropriateness depend on the service and your consultation.",
	},
	{
		question: "Do I need an appointment?",
		answer:
			"Appointments help Eden route you to the right team and service. You can book online or call the club to discuss the best first step.",
	},
	{
		question: "Is Eden near the Denver Tech Center?",
		answer:
			"Yes. Eden is in Greenwood Village near DTC and is convenient to Cherry Hills, Centennial, Englewood, Littleton, Lone Tree, and Highlands Ranch.",
	},
];

const jsonLd: JsonLd[] = [
	{
		"@context": "https://schema.org",
		"@type": "MedicalBusiness",
		"@id": `${canonical}#business`,
		name: "Eden Health Club",
		url: canonical,
		telephone: "+17206057678",
		address: {
			"@type": "PostalAddress",
			streetAddress: "5990 S University Blvd",
			addressLocality: "Greenwood Village",
			addressRegion: "CO",
			postalCode: "80121",
			addressCountry: "US",
		},
		hasMap:
			"https://www.google.com/maps/search/?api=1&query=Eden%20Health%20Club%205990%20S%20University%20Blvd%20Greenwood%20Village%20CO%2080121",
		sameAs: [
			"https://www.facebook.com/edenhealthclubs",
			"https://www.instagram.com/edenhealthclubs",
			"https://www.tiktok.com/@edenhealthclubs",
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "Service",
		"@id": `${canonical}#service`,
		name: "Medical Spa and Wellness Care in Greenwood Village",
		serviceType: "Medical Spa",
		provider: { "@id": `${canonical}#business` },
		areaServed: ["Greenwood Village", "Denver Tech Center", "Centennial", "Littleton", "Lone Tree"],
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"@id": `${canonical}#faq`,
		mainEntity: faqs.map((faq) => ({
			"@type": "Question",
			name: faq.question,
			acceptedAnswer: { "@type": "Answer", text: faq.answer },
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: "https://edenhealthclubs.com/" },
			{ "@type": "ListItem", position: 2, name: "Medical Spa Greenwood Village", item: canonical },
		],
	},
];
---

<BaseLayout
	title={title}
	description={description}
	canonicalUrl={canonical}
	jsonLd={jsonLd}
	noindex={true}
	preloadImages={["/assets/eden-health-club-reception.webp"]}
>
	<header class="border-b border-white/10 bg-eden-forest text-white">
		<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
			<a href="https://edenhealthclubs.com/" class="text-sm font-semibold tracking-wide">EDEN HEALTH CLUB</a>
			<div class="flex items-center gap-4 text-sm">
				<a href="tel:+17206057678" class="hidden text-white/85 sm:inline">720-605-7678</a>
				<a href={bookingUrl} class="rounded-md bg-eden-sage px-4 py-2 font-semibold text-eden-forest">Book a visit</a>
			</div>
		</div>
	</header>

	<main class="bg-eden-paper">
		<section class="relative isolate overflow-hidden bg-eden-forest text-white">
			<div class="absolute inset-0 -z-10">
				<img
					src="/assets/eden-health-club-reception.webp"
					alt="Eden Health Club reception in Greenwood Village"
					class="h-full w-full object-cover"
					loading="eager"
					fetchpriority="high"
					width="1388"
					height="1000"
				/>
				<div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(17,62,44,0.96),rgba(17,62,44,0.83)_52%,rgba(17,62,44,0.48))]"></div>
			</div>
			<div class="mx-auto grid max-w-6xl gap-10 px-6 py-18 sm:py-24 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.16em] text-eden-sage">Greenwood Village · Near DTC</p>
					<h1 class="mt-5 max-w-3xl text-5xl font-semibold leading-[1.03] sm:text-6xl">
						Medical spa & wellness care that starts with a real conversation.
					</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-white/88">
						Eden Health Club brings aesthetics, recovery, fitness, and provider-guided wellness care together at one in-person location in Greenwood Village.
					</p>
					<div class="mt-9 flex flex-col gap-3 sm:flex-row">
						<a href={bookingUrl} class="rounded-md bg-eden-sage px-6 py-3 text-center font-semibold text-eden-forest">Book a Greenwood Village visit</a>
						<a href={directionsUrl} class="rounded-md border border-white/45 px-6 py-3 text-center font-semibold text-white hover:bg-white/10">Get directions</a>
					</div>
				</div>
				<aside class="rounded-xl border border-white/15 bg-white/95 p-6 text-eden-navy shadow-2xl">
					<p class="text-xs font-semibold uppercase tracking-[0.14em] text-eden-green">Visit Eden</p>
					<p class="mt-4 text-xl font-semibold">5990 S University Blvd</p>
					<p class="mt-1 text-slate-700">Greenwood Village, CO 80121</p>
					<div class="mt-6 border-y border-eden-line py-5 text-sm leading-6 text-slate-700">
						<p>Near the Denver Tech Center</p>
						<p>Serving Greenwood Village and nearby south Denver communities</p>
					</div>
					<a href="tel:+17206057678" class="mt-5 inline-block font-semibold text-eden-green underline underline-offset-4">Call 720-605-7678</a>
				</aside>
			</div>
		</section>

		<section class="bg-white px-6 py-10">
			<div class="mx-auto grid max-w-6xl gap-5 sm:grid-cols-3">
				<div class="border-l-2 border-eden-sage pl-4"><p class="font-semibold">One physical location</p><p class="mt-1 text-sm leading-6 text-slate-700">A real Greenwood Village destination—not a virtual office or satellite listing.</p></div>
				<div class="border-l-2 border-eden-sage pl-4"><p class="font-semibold">One connected experience</p><p class="mt-1 text-sm leading-6 text-slate-700">Aesthetics, wellness, recovery, and fitness can be explored in the same visit.</p></div>
				<div class="border-l-2 border-eden-sage pl-4"><p class="font-semibold">One clear next step</p><p class="mt-1 text-sm leading-6 text-slate-700">Book the service you know you want or start with a consultation.</p></div>
			</div>
		</section>

		<section class="px-6 py-18 sm:py-24">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold uppercase tracking-[0.14em] text-eden-green">Explore services at Eden</p>
					<h2 class="mt-4 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">Start with the care that fits your visit.</h2>
					<p class="mt-5 text-lg leading-8 text-slate-700">Use these service areas to explore Eden. Your consultation and provider guidance determine the appropriate next step.</p>
				</div>
				<div class="mt-10 grid gap-5 md:grid-cols-2">
					{services.map((service) => (
						<a href={service.href} class="group rounded-xl border border-eden-line bg-white p-7 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
							<h3 class="text-xl font-semibold text-eden-navy">{service.name}</h3>
							<p class="mt-3 text-sm leading-7 text-slate-700">{service.body}</p>
							<span class="mt-6 inline-block text-sm font-semibold text-eden-green group-hover:underline">Explore this service →</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="bg-eden-navy px-6 py-18 text-white">
			<div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.14em] text-eden-sage">Plan your visit</p>
					<h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-4xl">Convenient care near DTC, with room to ask better questions.</h2>
				</div>
				<div class="grid gap-4 sm:grid-cols-3">
					<div class="rounded-lg border border-white/15 bg-white/5 p-5"><p class="font-semibold">1. Choose a starting point</p><p class="mt-2 text-sm leading-6 text-white/75">Select a known service or book time to talk through options.</p></div>
					<div class="rounded-lg border border-white/15 bg-white/5 p-5"><p class="font-semibold">2. Visit in person</p><p class="mt-2 text-sm leading-6 text-white/75">Meet the relevant Eden team at the Greenwood Village location.</p></div>
					<div class="rounded-lg border border-white/15 bg-white/5 p-5"><p class="font-semibold">3. Leave with clarity</p><p class="mt-2 text-sm leading-6 text-white/75">Understand the appropriate next step and how to follow through.</p></div>
				</div>
			</div>
		</section>

		<FAQAccordion faqs={faqs} heading="Greenwood Village medical spa FAQs" />

		<section class="bg-white px-6 py-18 text-center sm:py-22">
			<div class="mx-auto max-w-2xl">
				<p class="text-sm font-semibold uppercase tracking-[0.14em] text-eden-green">Ready when you are</p>
				<h2 class="mt-4 text-3xl font-semibold text-eden-navy sm:text-4xl">Visit Eden Health Club in Greenwood Village.</h2>
				<p class="mt-5 text-lg leading-8 text-slate-700">Book online, call the team, or get directions to the club.</p>
				<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
					<a href={bookingUrl} class="rounded-md bg-eden-forest px-6 py-3 font-semibold text-white">Book a visit</a>
					<a href="tel:+17206057678" class="rounded-md border border-eden-forest px-6 py-3 font-semibold text-eden-forest">Call 720-605-7678</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="bg-eden-forest px-6 py-10 text-white">
		<div class="mx-auto flex max-w-6xl flex-col justify-between gap-4 text-sm sm:flex-row sm:items-end">
			<div><p class="font-semibold">Eden Health Club</p><p class="mt-2 text-white/75">5990 S University Blvd · Greenwood Village, CO 80121</p></div>
			<p class="max-w-lg text-xs leading-5 text-white/60">Prototype only. This review page is noindex and shows the recommended main-domain location-page structure; all live medical/service claims require Eden’s clinical and inventory review.</p>
		</div>
	</footer>
</BaseLayout>
