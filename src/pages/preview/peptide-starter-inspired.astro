		font-size: clamp(1.65rem, 2.2vw, 2.25rem);
	}
	main[data-peptide-page] #lead-form input,
	main[data-peptide-page] #lead-form select {
		min-height: 48px;
		border-radius: 14px;
		font-size: 16px;
	}
	main[data-peptide-page] #lead-form button[type="submit"] {
		min-height: 52px;
		border-radius: 999px;
	}
	main[data-peptide-page] #glp-reviews-heading + a,
	main[data-peptide-page] a {
		text-underline-offset: 3px;
	}
</style>

<script>
	const gallery = document.querySelector<HTMLElement>("[data-peptide-gallery]");
	const track = gallery?.querySelector<HTMLElement>("[data-gallery-track]");
	if (gallery && track) {
		const previous = gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-previous]");
		const next = gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-next]");
		const updateControls = () => {
			const atStart = track.scrollLeft <= 4;
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
			previous.forEach((button) => (button.disabled = atStart));
			next.forEach((button) => (button.disabled = atEnd));
		};
		const move = (direction: number) => {
			const card = track.firstElementChild as HTMLElement | null;
			track.scrollBy({ left: direction * ((card?.offsetWidth ?? track.clientWidth) + 16), behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
		};
		previous.forEach((button) => button.addEventListener("click", () => move(-1)));
		next.forEach((button) => button.addEventListener("click", () => move(1)));
		track.addEventListener("scroll", updateControls, { passive: true });
		window.addEventListener("resize", updateControls);
		updateControls();
	}
</script>
