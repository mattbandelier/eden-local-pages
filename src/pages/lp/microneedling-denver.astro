---
import LeadForm from "../../components/content/LeadForm.astro";
import Footer from "../../components/layout/Footer.astro";
import PremiumHeader from "../../components/layout/PremiumHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { canonicalUrl, homeUrl } from "../../lib/urls";
import type { JsonLd } from "../../lib/schema-org";

const canonical = canonicalUrl("/lp/microneedling-denver");
const title = "Microneedling in Greenwood Village | Eden Health Club";
const description =
	"Request a provider-guided microneedling consultation in Greenwood Village near DTC. Eden helps you compare skin texture, pores, fine lines, acne-scarring concerns, and treatment timing.";

const faqs = [
	{
		question: "What happens during a microneedling consult?",
		answer:
			"Eden reviews your goals, skin history, areas of concern, timing, and fit. The team explains the next step before you schedule treatment.",
	},
	{
		question: "Who is this microneedling page for?",
		answer:
			"It is for adults comparing microneedling near Greenwood Village, DTC, Denver, Centennial, Cherry Hills Village, and the south Denver metro.",
	},
	{
		question: "What concerns can I discuss?",
		answer:
			"You can discuss texture, pores, fine lines, uneven-looking skin, acne-scarring concerns, treatment depth, downtime, and whether microneedling fits your goals.",
	},
	{
		question: "Where is Eden Health Club?",
		answer:
			"Eden Health Club is at 5990 S University Blvd in Greenwood Village, near the Denver Tech Center.",
	},
];

const jsonLd: JsonLd[] = [
	{
		"@context": "https://schema.org",
		"@type": "MedicalBusiness",
		"@id": `${canonical}#medical-business`,
		name: "Eden Health Club",
		url: canonical,
		telephone: "+17206057678",
		address: {
			"@type": "PostalAddress",
			streetAddress: "5990 S University Blvd",
			addressLocality: "Greenwood Village",
			addressRegion: "CO",
			postalCode: "80121",
			addressCountry: "US",
		},
		areaServed: [
			{ "@type": "City", name: "Greenwood Village", addressRegion: "CO" },
			{ "@type": "City", name: "Denver", addressRegion: "CO" },
			{ "@type": "City", name: "Centennial", addressRegion: "CO" },
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "Service",
		"@id": `${canonical}#service`,
		name: "Microneedling consultation",
		serviceType: "Microneedling consultation",
		url: canonical,
		description,
		provider: {
			"@id": `${canonical}#medical-business`,
			"@type": "MedicalBusiness",
			name: "Eden Health Club",
		},
		areaServed: "Greenwood Village, Denver Tech Center, Denver, Centennial, Cherry Hills Village, and South Denver",
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"@id": `${canonical}#faq`,
		mainEntity: faqs.map((faq) => ({
			"@type": "Question",
			name: faq.question,
			acceptedAnswer: { "@type": "Answer", text: faq.answer },
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: homeUrl() },
			{ "@type": "ListItem", position: 2, name: "Microneedling", item: canonical },
		],
	},
];
---

<BaseLayout title={title} description={description} canonicalUrl={canonical} jsonLd={jsonLd} noindex={true} preloadImages={["/assets/microneedling-treatment-hero-1200.webp"]}>
	<PremiumHeader servicesHref="#details" servicesLabel="Services" pricingHref="#lead-form" contactHref="#lead-form" ctaLabel="Request a Consult" />
	<main class="bg-eden-paper pb-20 md:pb-0">
		<section class="relative overflow-hidden bg-eden-forest text-white">
			<div class="absolute inset-0">
				<img src="/assets/microneedling-treatment-hero-1200.webp" srcset="/assets/microneedling-treatment-hero-750.webp 750w, /assets/microneedling-treatment-hero-1200.webp 1200w, /assets/microneedling-treatment-hero-1448.webp 1448w" sizes="100vw" alt="Microneedling treatment with a provider in a private clinical room" class="microneedling-hero-image h-full w-full object-cover object-[62%_center] opacity-60" loading="eager" fetchpriority="high" decoding="async" width="1448" height="1086" />
				<video
					class="absolute inset-0 hidden h-full w-full object-cover opacity-20 md:block"
					data-deferred-hero-video
					autoplay
					muted
					loop
					playsinline
					preload="none"
					poster="/assets/microneedling-treatment-hero-1200.webp"
					aria-hidden="true"
				>
					<source data-src="https://edenhealthclubs.com/wp-content/uploads/2025/07/edenhealth-hero-video.mp4" type="video/mp4" />
				</video>
				<div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(28,45,38,0.98),rgba(25,79,57,0.84)_48%,rgba(25,79,57,0.36))]"></div>
			</div>
			<div class="relative mx-auto grid min-h-[calc(100vh-64px)] max-w-6xl gap-10 px-6 py-12 sm:py-16 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
				<div>
					<p class="text-sm font-semibold uppercase tracking-normal text-eden-sage">Microneedling in Denver</p>
					<h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">Microneedling in Greenwood Village.</h1>
					<p class="mt-5 max-w-2xl text-base leading-8 text-white/86 sm:text-lg">Talk through texture, pores, fine lines, and acne-scarring concerns with Eden's team, then leave with a clear plan before anything is scheduled.</p>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a href="#lead-form" class="rounded-md bg-eden-sage px-6 py-3 text-center text-base font-semibold text-eden-forest shadow-sm">Request a microneedling consult</a>
						<a href="tel:+17206057678" data-phone-link class="rounded-md border border-white/35 px-6 py-3 text-center text-base font-semibold text-white hover:bg-white/10">Call 720-605-7678</a>
					</div>
					<p class="mt-5 max-w-2xl text-xs leading-6 text-white/62">Discuss your goals, skin history, treatment timing, and fit with the Eden team before scheduling. Treatment recommendations and outcomes vary by person.</p>
					<div class="mt-8 grid gap-3 text-sm text-white/88 sm:grid-cols-3">
						<div class="rounded-lg border border-white/15 bg-white/10 p-4"><p class="text-xs font-semibold uppercase text-eden-sage">Local</p><p class="mt-2 font-semibold">Greenwood Village near DTC</p></div>
						<div class="rounded-lg border border-white/15 bg-white/10 p-4"><p class="text-xs font-semibold uppercase text-eden-sage">Start clear</p><p class="mt-2 font-semibold">Consult before scheduling</p></div>
						<div class="rounded-lg border border-white/15 bg-white/10 p-4"><p class="text-xs font-semibold uppercase text-eden-sage">Eden setting</p><p class="mt-2 font-semibold">A real local facility</p></div>
					</div>
				</div>
				<div class="overflow-hidden rounded-lg border border-white/15 bg-white/10 p-3 shadow-2xl backdrop-blur">
					<div class="relative overflow-hidden rounded-md">
						<img src="/assets/microneedling-skinpen-device.webp" alt="SkinPen device prepared for a microneedling treatment at Eden Health Club" class="microneedling-card-image h-80 w-full object-cover object-center sm:h-[28rem]" loading="lazy" decoding="async" width="900" height="600" />
						<div class="absolute inset-x-4 bottom-4 rounded-md border border-white/25 bg-eden-forest/88 p-4 text-white shadow-xl backdrop-blur">
							<p class="text-xs font-semibold uppercase text-eden-sage">Provider-guided microneedling</p>
							<p class="mt-2 text-xl font-semibold leading-tight">A clear plan for texture, pores, fine lines, and acne-scarring concerns.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="details" class="bg-white px-6 py-12 sm:py-16">
			<div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
				<div>
					<p class="text-sm font-semibold uppercase text-eden-green">Best for people comparing</p>
					<h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">One clear microneedling starting point near Denver.</h2>
					<p class="mt-4 text-base leading-8 text-slate-700">Share what you are considering and Eden will help clarify fit, timing, skin concerns, and the right next conversation before treatment is scheduled.</p>
				</div>
				<div class="grid gap-4 sm:grid-cols-2">
					<div class="rounded-lg border border-eden-line bg-eden-paper p-5"><h3 class="text-xl font-semibold text-eden-navy">Goal review</h3><p class="mt-3 text-sm leading-6 text-slate-700">Discuss texture, pores, fine lines, acne-scarring concerns, and the areas you want to understand.</p></div>
					<div class="rounded-lg border border-eden-line bg-eden-paper p-5"><h3 class="text-xl font-semibold text-eden-navy">Treatment planning</h3><p class="mt-3 text-sm leading-6 text-slate-700">Talk through treatment depth, timing, downtime, and whether microneedling fits your goals.</p></div>
					<div class="rounded-lg border border-eden-line bg-eden-paper p-5"><h3 class="text-xl font-semibold text-eden-navy">Local access</h3><p class="mt-3 text-sm leading-6 text-slate-700">Visit Eden at 5990 S University Blvd in Greenwood Village, minutes from the Denver Tech Center.</p></div>
					<div class="rounded-lg border border-eden-line bg-eden-paper p-5"><h3 class="text-xl font-semibold text-eden-navy">Next step</h3><p class="mt-3 text-sm leading-6 text-slate-700">Leave with a clearer understanding of scheduling, preparation, and follow-up.</p></div>
				</div>
			</div>
		</section>

		<section class="px-6 py-12 sm:py-16">
			<div class="mx-auto max-w-6xl">
				<p class="text-sm font-semibold uppercase text-eden-green">What to expect</p>
				<h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">A clear path from question to next step.</h2>
				<div class="mt-8 grid gap-4 md:grid-cols-3">
					<div class="rounded-lg border border-eden-line bg-white p-6 shadow-sm"><p class="text-xs font-semibold uppercase text-eden-green">01</p><h3 class="mt-2 text-xl font-semibold text-eden-navy">Tell us what you notice</h3><p class="mt-3 text-sm leading-6 text-slate-700">Share the skin concern, area, and timing you are comparing.</p></div>
					<div class="rounded-lg border border-eden-line bg-white p-6 shadow-sm"><p class="text-xs font-semibold uppercase text-eden-green">02</p><h3 class="mt-2 text-xl font-semibold text-eden-navy">Review fit</h3><p class="mt-3 text-sm leading-6 text-slate-700">Eden reviews your goals and explains the care path before scheduling.</p></div>
					<div class="rounded-lg border border-eden-line bg-white p-6 shadow-sm"><p class="text-xs font-semibold uppercase text-eden-green">03</p><h3 class="mt-2 text-xl font-semibold text-eden-navy">Choose the next step</h3><p class="mt-3 text-sm leading-6 text-slate-700">Move forward with clear timing and expectations that fit your plan.</p></div>
				</div>
			</div>
		</section>

		<section class="bg-white px-6 py-12 sm:py-16">
			<div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
				<div><p class="text-sm font-semibold uppercase text-eden-green">Request a consult</p><h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">Start with a conversation that fits your goals.</h2><p class="mt-4 text-base leading-8 text-slate-700">Tell Eden what you are considering. The team will follow up about fit, timing, and the right next step.</p></div>
				<LeadForm serviceSlug="microneedling" suburbSlug="greenwood-village" heading="Request a microneedling consult" subheading="Share your goal and Eden will follow up about fit and timing." submitText="Request my consult" hiddenMessage="SOURCE_LANE: src_google_medspa. MICRONEEDLING CONSULT requested from the dedicated Google Ads page." />
			</div>
		</section>

		<section class="px-6 py-12 sm:py-16" aria-labelledby="microneedling-faq-heading">
			<div class="mx-auto max-w-4xl"><p class="text-sm font-semibold uppercase text-eden-green">FAQ</p><h2 id="microneedling-faq-heading" class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">Questions before your consult.</h2><div class="mt-8 divide-y divide-eden-line rounded-lg border border-eden-line bg-white">{faqs.map((faq) => <details class="group p-5"><summary class="cursor-pointer list-none text-lg font-semibold text-eden-navy">{faq.question}</summary><p class="mt-3 text-sm leading-7 text-slate-700">{faq.answer}</p></details>)}</div></div>
		</section>
	</main>
	<div class="fixed inset-x-0 bottom-0 z-40 border-t border-eden-line bg-white/96 p-3 shadow-lg backdrop-blur md:hidden"><div class="mx-auto flex max-w-md gap-2"><a href="#lead-form" class="flex-1 rounded-md bg-eden-green px-4 py-3 text-center text-sm font-semibold text-white">Request a consult</a><a href="tel:+17206057678" data-phone-link class="rounded-md border border-eden-line px-4 py-3 text-center text-sm font-semibold text-eden-navy">Call</a></div></div>
	<Footer />
</BaseLayout>

<style>
	.microneedling-hero-image {
		animation: microneedling-hero-drift 18s ease-in-out infinite alternate;
		transform: scale(1.04);
	}

	.microneedling-card-image {
		animation: microneedling-card-drift 14s ease-in-out infinite alternate;
		transform: scale(1.03);
	}

	@keyframes microneedling-hero-drift {
		from { transform: scale(1.04) translate3d(0, 0, 0); }
		to { transform: scale(1.08) translate3d(-1%, -0.5%, 0); }
	}

	@keyframes microneedling-card-drift {
		from { transform: scale(1.03) translate3d(0, 0, 0); }
		to { transform: scale(1.07) translate3d(-1%, -1%, 0); }
	}

	@media (prefers-reduced-motion: reduce) {
		.microneedling-hero-image,
		.microneedling-card-image {
			animation: none;
			transform: none;
		}
	}
</style>
