							<div class="overflow-hidden rounded-md">
								<img src="/assets/eden-functional-consult-air.webp" alt="Eden provider reviewing a health plan with a guest in a private consultation room" class="h-full min-h-72 w-full object-cover object-center" loading="eager" fetchpriority="high" decoding="async" width="900" height="1600" />
							</div>
							<div class="grid gap-3">
