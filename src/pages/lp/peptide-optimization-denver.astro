---

<BaseLayout
	title={title}
	description={description}
	canonicalUrl={canonical}
	jsonLd={jsonLd}
	noindex={true}
	preloadImages={["/assets/eden-functional-consult-air.webp", "/assets/eden-health-club-logo-white-transparent-tight.png"]}
>
	<PremiumHeader servicesHref="#offer" servicesLabel="Programs" pricingHref="#lead-form" contactHref="#lead-form" ctaLabel="Request my $299 starter" />
	<main class="bg-eden-paper">
		<section class="relative overflow-hidden bg-eden-forest text-white">
			<div class="absolute inset-0 bg-[linear-gradient(112deg,#1c2d26,rgba(25,79,57,0.96)_48%,#173b2c)]"></div>
			<div class="relative mx-auto grid min-h-[calc(100vh-64px)] max-w-6xl gap-10 px-6 py-12 sm:py-16 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
