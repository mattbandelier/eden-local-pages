<script>
	const starterSticky = document.querySelector<HTMLElement>("[data-peptide-starter-sticky]");
	const updateStarterSticky = () => {
		if (!starterSticky) return;
		const shouldShow = window.scrollY > window.innerHeight * 0.55;
		starterSticky.classList.toggle("opacity-0", !shouldShow);
		starterSticky.classList.toggle("translate-y-3", !shouldShow);
		starterSticky.classList.toggle("pointer-events-none", !shouldShow);
	};

	updateStarterSticky();
	window.addEventListener("scroll", updateStarterSticky, { passive: true });
	window.addEventListener("resize", updateStarterSticky);

	const reviewCarousel = document.querySelector<HTMLElement>("[data-review-carousel]");
	const reviewTrack = reviewCarousel?.querySelector<HTMLElement>("[data-review-track]");
	const reviewCards = reviewTrack ? Array.from(reviewTrack.querySelectorAll<HTMLElement>("[data-review-card]")) : [];
	const reviewDots = reviewCarousel ? Array.from(reviewCarousel.querySelectorAll<HTMLButtonElement>("[data-review-dot]")) : [];
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	let reviewIndex = 0;
	let reviewTimer: number | undefined;

	const showReview = (index: number, behavior: ScrollBehavior = "smooth") => {
		if (!reviewTrack || !reviewCards.length) return;
		reviewIndex = (index + reviewCards.length) % reviewCards.length;
		reviewTrack.scrollTo({ left: reviewCards[reviewIndex].offsetLeft, behavior });
		reviewDots.forEach((dot, dotIndex) => {
			dot.classList.toggle("bg-eden-sage", dotIndex === reviewIndex);
			dot.classList.toggle("bg-white/30", dotIndex !== reviewIndex);
			dot.setAttribute("aria-current", dotIndex === reviewIndex ? "true" : "false");
		});
	};

	const stopReviewAutoplay = () => {
		if (reviewTimer) window.clearInterval(reviewTimer);
		reviewTimer = undefined;
	};

	const startReviewAutoplay = () => {
		if (!reviewTrack || reviewCards.length < 2 || reduceMotion || reviewTimer) return;
		reviewTimer = window.setInterval(() => showReview(reviewIndex + 1), 6500);
	};

	if (reviewCarousel && reviewTrack) {
		reviewCarousel.querySelector<HTMLButtonElement>("[data-review-prev]")?.addEventListener("click", () => {
			stopReviewAutoplay();
			showReview(reviewIndex - 1);
		});
		reviewCarousel.querySelector<HTMLButtonElement>("[data-review-next]")?.addEventListener("click", () => {
			stopReviewAutoplay();
			showReview(reviewIndex + 1);
		});
		reviewDots.forEach((dot, index) => dot.addEventListener("click", () => {
			stopReviewAutoplay();
			showReview(index);
		}));
		reviewCarousel.addEventListener("mouseenter", stopReviewAutoplay);
		reviewCarousel.addEventListener("mouseleave", startReviewAutoplay);
		reviewCarousel.addEventListener("focusin", stopReviewAutoplay);
		reviewCarousel.addEventListener("focusout", startReviewAutoplay);
		reviewCarousel.addEventListener("touchstart", stopReviewAutoplay, { passive: true });
		document.addEventListener("visibilitychange", () => document.hidden ? stopReviewAutoplay() : startReviewAutoplay());
		startReviewAutoplay();
	}
</script>
