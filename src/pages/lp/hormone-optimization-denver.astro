---
import LeadForm from "../../components/content/LeadForm.astro";
import PaidServiceFooter from "../../components/layout/PaidServiceFooter.astro";
import PremiumHeader from "../../components/layout/PremiumHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { JsonLd } from "../../lib/schema-org";
import { canonicalUrl } from "../../lib/urls";

const canonical = canonicalUrl("/lp/hormone-optimization-denver");
const title = "Hormone Specialist Denver | $149 Consult + Hormone Panel | Eden";
const description =
	"A $149 new-client hormone baseline for women and men in Greenwood Village near DTC: private consultation, hormone panel, InBody, and a clear next-step plan.";

const visitIncludes = [
	{
		title: "Private consultation",
		body: "Discuss symptoms, goals, health history, and the changes you want clarified in a private, in-person setting.",
	},
	{
		title: "Hormone panel + InBody",
		body: "Start with a hormone panel and body-composition baseline instead of guessing at what needs attention.",
	},
	{
		title: "Personalized next-step plan",
		body: "Leave with clear priorities, relevant next steps, and an informed decision about whether ongoing support fits.",
	},
];

const comparisonPoints = [
	["Starting point", "Symptoms, history, goals, and relevant labs", "A preset protocol selected before evaluation"],
	["Setting", "In-person care inside a private Greenwood Village health club", "Remote-only or high-volume care"],
	["Planning", "Provider-guided eligibility and safety review", "Treatment-first messaging"],
	["Follow-up", "Ongoing visits and lab monitoring when care moves forward", "A one-time transaction"],
];

const faqs = [
	{
		question: "What is included in the $149 hormone baseline?",
		answer:
			"The $149 new-client baseline includes a private consultation, a hormone panel, an InBody body-composition baseline, and a provider-guided next-step plan.",
	},
	{
		question: "Who is the hormone baseline for?",
		answer:
			"It is for women and men who want more clarity around symptoms, life stage, recovery, energy, sleep, body composition, or a possible hormone conversation.",
	},
	{
		question: "Does Eden provide hormone care for women and men?",
		answer:
			"Yes. Eden provides individualized hormone evaluation for women and men. The exact discussion depends on symptoms, life stage, health history, lab findings, and provider judgment.",
	},
	{
		question: "Does the baseline guarantee a specific recommendation?",
		answer:
			"No. The baseline is an evaluation and planning visit. Recommendations depend on the provider review, health history, and the information available at the visit.",
	},
	{
		question: "Where is Eden Health Club located?",
		answer:
			"Eden is located at 5990 S University Blvd in Greenwood Village, close to Denver Tech Center, Cherry Hills Village, Centennial, Englewood, Littleton, Lone Tree, Highlands Ranch, and South Denver.",
	},
];

const jsonLd: JsonLd[] = [
	{
		"@context": "https://schema.org",
		"@type": "MedicalBusiness",
		"@id": `${canonical}#medical-business`,
		name: "Eden Health Club",
		url: canonical,
		telephone: "+17206057678",
		address: {
			"@type": "PostalAddress",
			streetAddress: "5990 S University Blvd",
			addressLocality: "Greenwood Village",
			addressRegion: "CO",
			postalCode: "80121",
			addressCountry: "US",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "Service",
		"@id": `${canonical}#service`,
		name: "Hormone Optimization Consultation",
		serviceType: "Hormone evaluation and care planning",
		url: canonical,
		description,
		provider: {
			"@id": `${canonical}#medical-business`,
			"@type": "MedicalBusiness",
			name: "Eden Health Club",
		},
		areaServed: "Denver, Greenwood Village, Denver Tech Center, and South Denver",
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"@id": `${canonical}#faq`,
		mainEntity: faqs.map((faq) => ({
			"@type": "Question",
			name: faq.question,
			acceptedAnswer: {
				"@type": "Answer",
				text: faq.answer,
			},
		})),
	},
];
---

<BaseLayout
	title={title}
	description={description}
	canonicalUrl={canonical}
	jsonLd={jsonLd}
	noindex
	preloadImages={["/assets/eden-health-club-reception.webp"]}
>
	<PremiumHeader
		brandHref={null}
		servicesHref="#visit"
		servicesLabel="The Visit"
		pricingHref="#questions"
		pricingLabel="Questions"
		contactHref="#lead-form"
		ctaLabel="Request a Consult"
	/>

	<main class="bg-eden-paper pb-20 md:pb-0">
		<section class="relative overflow-hidden bg-eden-forest text-white">
			<img
				src="/assets/eden-health-club-reception.webp"
				alt=""
				class="absolute inset-0 h-full w-full object-cover opacity-45"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				width="1388"
				height="1000"
			/>
			<div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(28,45,38,0.97),rgba(28,45,38,0.84)_52%,rgba(28,45,38,0.46))]"></div>
			<div class="relative mx-auto grid min-h-[680px] max-w-6xl gap-10 px-6 py-14 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold uppercase text-eden-sage">Hormone specialist · Greenwood Village near DTC</p>
					<h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">
						A $149 hormone baseline for women and men in Denver.
					</h1>
					<p class="mt-6 max-w-xl text-lg leading-8 text-white/82">
						Start with a private consultation, hormone panel, InBody baseline, and a clear next-step plan for energy, sleep, mood, recovery, or body composition.
					</p>
					<div class="mt-7 flex flex-wrap gap-3 text-sm font-semibold text-white/88">
						<span class="rounded-md border border-white/20 bg-white/10 px-3 py-2">$149 new-client visit</span>
						<span class="rounded-md border border-white/20 bg-white/10 px-3 py-2">Hormone panel + InBody</span>
						<span class="rounded-md border border-white/20 bg-white/10 px-3 py-2">Provider-led roadmap</span>
					</div>
					<p class="mt-6 text-sm leading-6 text-white/68">
						Recommendations depend on provider review, health history, and the information available at your visit.
					</p>
				</div>

				<LeadForm
					serviceSlug="hormone-optimization"
					suburbSlug="denver"
					heading="Request your $149 hormone baseline"
					subheading="Eden will follow up with scheduling details and what to expect from your consultation, hormone panel, InBody baseline, and review."
					submitText="Request My $149 Baseline"
					messageLabel="What would you like help with?"
					goalOptions={[
						"Energy, sleep, or recovery",
						"Menopause or perimenopause support",
						"Men's hormone evaluation",
						"Body composition or weight changes",
						"I am not sure yet",
					]}
					hiddenMessage="Hormone Optimization Denver paid landing page $149 baseline request"
					offerName="$149 Hormone Baseline"
					offerValue="private_consult_hormone_panel_inbody_provider_roadmap"
				/>
			</div>
		</section>

		<section id="visit" class="px-6 py-14 sm:py-18">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-3xl">
					<p class="text-sm font-semibold uppercase text-eden-green">A clear first step</p>
					<h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">
						A $149 starting point before any ongoing hormone decision.
					</h2>
					<p class="mt-4 text-base leading-7 text-slate-700">
						Instead of starting with a generic protocol, Eden starts with your experience, a hormone panel, and body-composition context.
					</p>
				</div>
				<div class="mt-8 grid gap-5 md:grid-cols-3">
					{visitIncludes.map((item, index) => (
						<article class="border-t-2 border-eden-green bg-white p-6 shadow-sm">
							<p class="text-sm font-semibold text-eden-green">0{index + 1}</p>
							<h3 class="mt-3 text-xl font-semibold text-eden-navy">{item.title}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-700">{item.body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="bg-white px-6 py-14 sm:py-18">
			<div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
				<div class="overflow-hidden rounded-lg">
					<img
						src="/assets/eden-health-club-office.webp"
						alt="Private consultation space at Eden Health Club in Greenwood Village"
						class="aspect-[4/3] h-full w-full object-cover"
						loading="lazy"
						decoding="async"
						width="1388"
						height="1000"
					/>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase text-eden-green">Built around the person</p>
					<h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">
						Women and men need individualized hormone conversations.
					</h2>
					<p class="mt-5 text-base leading-7 text-slate-700">
						Life stage, symptoms, health history, medications, goals, and lab findings all shape the conversation. Eden’s role is to help you understand what is relevant, what needs more evaluation, and what responsible follow-up looks like.
					</p>
					<ul class="mt-6 grid gap-3 text-sm leading-6 text-slate-700 sm:grid-cols-2">
						<li class="border-l-2 border-eden-sage pl-4">Energy, sleep, mood, and recovery</li>
						<li class="border-l-2 border-eden-sage pl-4">Perimenopause and menopause concerns</li>
						<li class="border-l-2 border-eden-sage pl-4">Men’s hormone and low-testosterone evaluation</li>
						<li class="border-l-2 border-eden-sage pl-4">Body composition, strength, and performance context</li>
					</ul>
				</div>
			</div>
		</section>

		<section class="bg-eden-forest px-6 py-14 text-white sm:py-18">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-3xl">
					<p class="text-sm font-semibold uppercase text-eden-sage">Why Eden</p>
					<h2 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">
						A private local alternative to one-size-fits-all hormone care.
					</h2>
				</div>
				<div class="mt-8 overflow-x-auto">
					<table class="w-full min-w-[720px] border-collapse text-left text-sm">
						<thead>
							<tr class="border-b border-white/20">
								<th class="px-4 py-4 font-semibold text-eden-sage">Compare</th>
								<th class="px-4 py-4 font-semibold text-white">Eden Health Club</th>
								<th class="px-4 py-4 font-semibold text-white/65">What clients often want to avoid</th>
							</tr>
						</thead>
						<tbody>
							{comparisonPoints.map((row) => (
								<tr class="border-b border-white/10 align-top">
									<th class="px-4 py-4 font-semibold text-white">{row[0]}</th>
									<td class="px-4 py-4 leading-6 text-white/82">{row[1]}</td>
									<td class="px-4 py-4 leading-6 text-white/58">{row[2]}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<section id="questions" class="px-6 py-14 sm:py-18">
			<div class="mx-auto max-w-4xl">
				<p class="text-sm font-semibold uppercase text-eden-green">Questions before you book</p>
				<h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">
					Hormone optimization consultations in Denver.
				</h2>
				<div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
					{faqs.map((faq) => (
						<details class="group py-5">
							<summary class="cursor-pointer list-none pr-8 text-lg font-semibold text-eden-navy">
								{faq.question}
							</summary>
							<p class="mt-3 max-w-3xl text-sm leading-7 text-slate-700">{faq.answer}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="bg-eden-sage px-6 py-12">
			<div class="mx-auto flex max-w-6xl flex-col gap-6 md:flex-row md:items-center md:justify-between">
				<div>
					<p class="text-sm font-semibold uppercase text-eden-forest">Greenwood Village · South Denver</p>
					<h2 class="mt-2 text-3xl font-semibold leading-tight text-eden-forest">Get clarity before choosing a hormone plan.</h2>
				</div>
				<a href="#lead-form" class="rounded-md bg-eden-forest px-6 py-3 text-center text-base font-semibold text-white">
					Request a Consultation
				</a>
			</div>
		</section>
	</main>

	<nav
		class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 border-t border-slate-200 bg-white/95 px-4 py-3 shadow-[0_-10px_30px_rgba(15,39,51,0.12)] backdrop-blur md:hidden"
		aria-label="Contact Eden"
	>
		<a href="tel:+17206057678" class="mr-2 rounded-md border border-eden-navy/15 px-4 py-3 text-center text-sm font-semibold text-eden-navy">
			Call
		</a>
		<a href="#lead-form" class="ml-2 rounded-md bg-eden-sage px-4 py-3 text-center text-sm font-semibold text-eden-forest">
			Consult
		</a>
	</nav>

	<PaidServiceFooter />
</BaseLayout>
