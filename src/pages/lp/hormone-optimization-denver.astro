---
import LeadForm from "../../components/content/LeadForm.astro";
import GuestReviewStrip from "../../components/content/GuestReviewStrip.astro";
import StickyMobileLeadActions from "../../components/content/StickyMobileLeadActions.astro";
import PaidServiceFooter from "../../components/layout/PaidServiceFooter.astro";
import PremiumHeader from "../../components/layout/PremiumHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { JsonLd } from "../../lib/schema-org";
import { canonicalUrl } from "../../lib/urls";

const canonical = canonicalUrl("/lp/hormone-optimization-denver");
const title = "Hormone Specialist Denver | $175 Consult + Lab Work | Eden";
const description =
	"A $175 new-client hormone consultation for women and men in Greenwood Village near DTC: private consultation, lab work, and a clear next-step plan.";

const visitIncludes = [
	{
		title: "Private consultation",
		body: "Discuss symptoms, goals, health history, and the changes you want clarified in a private, in-person setting.",
	},
	{
		title: "Relevant baseline panel",
		body: "Women's panel: FSH, estradiol, and total and free testosterone with SHBG. Men's panel: CBC, estradiol, and total and free testosterone with SHBG.",
	},
	{
		title: "Personalized next-step plan",
		body: "Leave with clear priorities, relevant next steps, and an informed decision about whether ongoing support fits.",
	},
];

const edenDifferences = [
	["Start with context", "Symptoms, health history, goals, and the relevant baseline panel shape the first conversation."],
	["Meet in person", "Private care inside Eden's Greenwood Village health club, minutes from DTC."],
	["Review before treatment", "Eligibility, safety, and the next step are considered before any ongoing plan."],
	["Build accountable follow-through", "Ongoing visits and lab monitoring can continue when care moves forward."],
];

const faqs = [
	{
		question: "What is included in the $175 hormone consultation?",
		answer:
			"The $175 new-client visit combines a $100 private consultation with the $75 hormone panel and a provider-guided next-step plan. The women's panel includes FSH, estradiol, and total and free testosterone with SHBG. The men's panel includes CBC, estradiol, and total and free testosterone with SHBG. Treatment is not included and is considered separately after provider review.",
	},
	{
		question: "Who is the hormone baseline for?",
		answer:
			"It is for women and men who want more clarity around symptoms, life stage, recovery, energy, sleep, body composition, or a possible hormone conversation.",
	},
	{
		question: "Does Eden provide hormone care for women and men?",
		answer:
			"Yes. Eden provides individualized hormone evaluation for women and men. The exact discussion depends on symptoms, life stage, health history, lab findings, and provider judgment.",
	},
	{
		question: "Does the baseline guarantee a specific recommendation?",
		answer:
			"No. The baseline is an evaluation and planning visit. Recommendations depend on the provider review, health history, and the information available at the visit.",
	},
	{
		question: "Where is Eden Health Club located?",
		answer:
			"Eden is located at 5990 S University Blvd in Greenwood Village, close to Denver Tech Center, Cherry Hills Village, Centennial, Englewood, Littleton, Lone Tree, Highlands Ranch, and South Denver.",
	},
];

const jsonLd: JsonLd[] = [
	{
		"@context": "https://schema.org",
		"@type": "MedicalBusiness",
		"@id": `${canonical}#medical-business`,
		name: "Eden Health Club",
		url: canonical,
		telephone: "+17206057678",
		address: {
			"@type": "PostalAddress",
			streetAddress: "5990 S University Blvd",
			addressLocality: "Greenwood Village",
			addressRegion: "CO",
			postalCode: "80121",
			addressCountry: "US",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "Service",
		"@id": `${canonical}#service`,
		name: "Hormone Optimization Consultation",
		serviceType: "Hormone evaluation and care planning",
		url: canonical,
		description,
		provider: {
			"@id": `${canonical}#medical-business`,
			"@type": "MedicalBusiness",
			name: "Eden Health Club",
		},
		areaServed: "Denver, Greenwood Village, Denver Tech Center, and South Denver",
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"@id": `${canonical}#faq`,
		mainEntity: faqs.map((faq) => ({
			"@type": "Question",
			name: faq.question,
			acceptedAnswer: {
				"@type": "Answer",
				text: faq.answer,
			},
		})),
	},
];
---

<BaseLayout
	title={title}
	description={description}
	canonicalUrl={canonical}
	jsonLd={jsonLd}
	noindex
	ogImage="/assets/eden-functional-consult-air.webp"
	preloadImages={["/assets/eden-health-club-logo-white-transparent-tight.png"]}
>
	<PremiumHeader
		brandHref={null}
		servicesHref="#visit"
		servicesLabel="The Visit"
		pricingHref="#questions"
		pricingLabel="Questions"
		contactHref="#lead-form"
		ctaLabel="Request a Consult"
	/>

	<main class="bg-eden-paper pb-24 md:pb-0">
		<section class="relative overflow-hidden bg-eden-forest text-white">
			<div class="absolute inset-0 bg-[linear-gradient(112deg,#1c2d26,rgba(25,79,57,0.96)_48%,#173b2c)]"></div>
			<div class="relative mx-auto grid max-w-6xl gap-10 px-6 py-4 sm:py-12 lg:min-h-[calc(100vh-150px)] lg:grid-cols-[1.02fr_0.98fr] lg:items-center lg:py-8">
				<div>
					<img
						src="/assets/eden-health-club-logo-white-transparent-tight.png"
						alt="Eden Health Club"
						class="mb-4 h-auto w-24 sm:w-40 lg:mb-8 lg:w-44"
						loading="eager"
						fetchpriority="high"
						decoding="async"
						width="744"
						height="447"
					/>
					<p class="text-sm font-semibold uppercase text-eden-sage">Hormone specialist · Greenwood Village near DTC</p>
					<h1 class="mt-4 max-w-3xl text-3xl font-semibold leading-tight sm:text-5xl">
						A $175 hormone consultation for women and men in Denver.
					</h1>
					<p class="mt-5 max-w-2xl text-base leading-7 text-white/86 sm:text-lg sm:leading-8">
						<span class="sm:hidden">Start with a private consultation, the appropriate hormone panel, and a clear next-step plan.</span>
						<span class="hidden sm:inline">Start with a private consultation, hormone lab work, and a clear next-step plan for energy, sleep, mood, recovery, or body-composition questions.</span>
					</p>
					<div class="mt-8 grid grid-cols-2 gap-3 sm:flex sm:flex-row">
						<a href="#lead-form" class="rounded-md bg-eden-sage px-4 py-3 text-center text-sm font-semibold text-eden-forest shadow-sm sm:px-6 sm:text-base">
							<span class="sm:hidden">Request Visit</span><span class="hidden sm:inline">Request My $175 Consultation</span>
						</a>
						<a href="tel:+17206057678" data-phone-link class="rounded-md border border-white/35 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-white/10 sm:px-6 sm:text-base">
							<span class="sm:hidden">Call Eden</span><span class="hidden sm:inline">Call 720-605-7678</span>
						</a>
					</div>
					<p class="mt-5 hidden max-w-2xl text-xs leading-6 text-white/62 sm:block">
						Treatment is not included. Recommendations depend on provider review, health history, and the information available at your visit.
					</p>
				</div>
				<div class="relative hidden lg:block">
					<div class="overflow-hidden rounded-lg border border-white/15 bg-white/10 p-3 shadow-2xl backdrop-blur">
						<div class="grid gap-3 sm:grid-cols-[1.12fr_0.88fr]">
							<div
								role="img"
								aria-label="Eden provider meeting with a guest during a private consultation"
								class="min-h-72 overflow-hidden rounded-md bg-[url('/assets/eden-functional-consult-air.webp')] bg-cover bg-center"
							></div>
							<div class="grid gap-3">
								<div class="overflow-hidden rounded-md">
									<img src="/assets/eden-health-club-reception.webp" alt="" class="h-40 w-full object-cover sm:h-full" loading="lazy" width="1388" height="1000" />
								</div>
								<div class="grid grid-cols-2 gap-3">
									<div class="rounded-md bg-white p-4 text-eden-navy">
										<p class="text-xs font-semibold uppercase text-eden-green">Women's panel</p>
										<p class="mt-2 text-sm font-semibold leading-5">FSH, estradiol, total + free testosterone with SHBG.</p>
									</div>
									<div class="rounded-md bg-eden-sage p-4 text-eden-forest">
										<p class="text-xs font-semibold uppercase">Men's panel</p>
										<p class="mt-2 text-sm font-semibold leading-5">CBC, estradiol, total + free testosterone with SHBG.</p>
									</div>
								</div>
							</div>
						</div>
						<div class="mt-3 rounded-md border border-eden-line bg-white p-5 text-eden-navy shadow-sm">
							<p class="text-sm font-semibold uppercase text-eden-green">Clarity before a care plan</p>
							<p class="mt-2 text-xl font-semibold leading-tight">One transparent visit with the right baseline panel for your hormone path.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<GuestReviewStrip />

		<section id="visit" class="border-b border-eden-line bg-white px-6 py-12 sm:py-16">
			<div class="mx-auto max-w-6xl">
				<div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
					<div class="max-w-xl">
						<p class="text-sm font-semibold uppercase text-eden-green">A clear first step</p>
						<h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">
							A $175 starting point before any ongoing hormone decision.
						</h2>
						<p class="mt-4 text-base leading-8 text-slate-700">
							The visit combines a $100 private consultation with the appropriate $75 hormone panel. Eden starts with your experience, relevant lab work, and the questions you want clarified.
						</p>
						<div class="mt-6 border-l-2 border-eden-green pl-5 text-sm leading-7 text-slate-700">
							Private and in person at Eden's Greenwood Village location, minutes from Denver Tech Center.
						</div>
					</div>
					<LeadForm
						serviceSlug="hormone-optimization"
						suburbSlug="denver"
						heading="Request your $175 hormone consultation"
						subheading="Eden will follow up with scheduling details and what to expect from your consultation, lab work, and review."
						submitText="Request My $175 Consultation"
						messageLabel="What would you like help with?"
						goalOptions={[
							"Energy, sleep, or recovery",
							"Menopause or perimenopause support",
							"Men's hormone evaluation",
							"Body composition or weight changes",
							"I am not sure yet",
						]}
						hiddenMessage="Hormone Optimization Denver paid landing page $175 consultation and lab work request"
						offerName="$175 Hormone Consultation + Lab Work"
						offerValue="private_consult_hormone_lab_work_provider_roadmap_175"
					/>
				</div>
				<div class="mt-10 grid gap-5 md:grid-cols-3">
					{visitIncludes.map((item, index) => (
						<article class="rounded-lg border border-eden-line bg-eden-paper p-6 shadow-sm">
							<p class="text-sm font-semibold text-eden-green">0{index + 1}</p>
							<h3 class="mt-3 text-xl font-semibold text-eden-navy">{item.title}</h3>
							<p class="mt-3 text-sm leading-6 text-slate-700">{item.body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="bg-white px-6 py-14 sm:py-18">
			<div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
				<div class="overflow-hidden rounded-lg">
					<img
						src="/assets/eden-functional-consult-air.webp"
						alt="Eden provider meeting with a guest during a private consultation"
						class="aspect-[4/3] w-full object-cover object-center"
						loading="lazy"
						decoding="async"
						width="900"
						height="1600"
					/>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase text-eden-green">Built around the person</p>
					<h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">
						Women and men need individualized hormone conversations.
					</h2>
					<p class="mt-5 text-base leading-7 text-slate-700">
						Life stage, symptoms, health history, medications, goals, and lab findings all shape the conversation. Eden’s role is to help you understand what is relevant, what needs more evaluation, and what responsible follow-up looks like.
					</p>
					<ul class="mt-6 grid gap-3 text-sm leading-6 text-slate-700 sm:grid-cols-2">
						<li class="border-l-2 border-eden-sage pl-4">Energy, sleep, mood, and recovery</li>
						<li class="border-l-2 border-eden-sage pl-4">Perimenopause and menopause concerns</li>
						<li class="border-l-2 border-eden-sage pl-4">Men’s hormone and low-testosterone evaluation</li>
						<li class="border-l-2 border-eden-sage pl-4">Body composition, strength, and performance context</li>
					</ul>
				</div>
			</div>
		</section>

		<section class="bg-eden-forest px-6 py-14 text-white sm:py-18">
			<div class="mx-auto max-w-6xl">
				<div class="max-w-3xl">
					<p class="text-sm font-semibold uppercase text-eden-sage">Why Eden</p>
					<h2 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">
						A private local alternative to one-size-fits-all hormone care.
					</h2>
				</div>
				<div class="mt-8 grid gap-4 sm:grid-cols-2">
					{edenDifferences.map(([title, body]) => (
						<article class="rounded-lg border border-white/15 bg-white/8 p-5 backdrop-blur">
							<h3 class="text-xl font-semibold text-white">{title}</h3>
							<p class="mt-3 text-sm leading-7 text-white/72">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="questions" class="px-6 py-14 sm:py-18">
			<div class="mx-auto max-w-4xl">
				<p class="text-sm font-semibold uppercase text-eden-green">Questions before you book</p>
				<h2 class="mt-3 text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">
					Hormone optimization consultations in Denver.
				</h2>
				<div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
					{faqs.map((faq) => (
						<details class="group py-5">
							<summary class="cursor-pointer list-none pr-8 text-lg font-semibold text-eden-navy">
								{faq.question}
							</summary>
							<p class="mt-3 max-w-3xl text-sm leading-7 text-slate-700">{faq.answer}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="bg-eden-sage px-6 py-12">
			<div class="mx-auto flex max-w-6xl flex-col gap-6 md:flex-row md:items-center md:justify-between">
				<div>
					<p class="text-sm font-semibold uppercase text-eden-forest">Greenwood Village · South Denver</p>
					<h2 class="mt-2 text-3xl font-semibold leading-tight text-eden-forest">Get clarity before choosing a hormone plan.</h2>
				</div>
				<a href="#lead-form" class="rounded-md bg-eden-forest px-6 py-3 text-center text-base font-semibold text-white">
					Request a Consultation
				</a>
			</div>
		</section>
	</main>

	<StickyMobileLeadActions
		primaryLabel="Request $175 Visit"
		ariaLabel="Request a hormone consultation"
		desktopEyebrow="$175 Hormone Consultation"
		desktopBody="Private consultation, hormone panel, and a clear provider-guided plan."
	/>

	<PaidServiceFooter />
</BaseLayout>
