---
import BaseLayout from '../../layouts/BaseLayout.astro';
interface Props { variant: 'bbl' | 'moxi' | 'offer'; slug: string; }
const { variant, slug } = Astro.props;
const service = variant === 'bbl' ? 'BBL HEROic' : variant === 'moxi' ? 'MOXI' : 'BBL or MOXI';
---
<BaseLayout title={`50% Off Your First ${service} Face Treatment | Eden Health Clubs`}
  description={`Explore ${service} in Greenwood Village. Request 50% off your first standalone face treatment. Provider consultation and clinical eligibility required.`}
  canonicalUrl={`https://landing.edenhealthclubs.com/lp/${slug}/`} noindex={true}>
  <link rel="stylesheet" href="/bbl-moxi/styles.css" />
  <link rel="stylesheet" href="/bbl-moxi/brand.css" />
  <div id="app" data-variant={variant}></div>
  <noscript>Please enable JavaScript to view this offer, or call <a href="tel:+17206057678">720-605-7678</a>.</noscript>
  <script is:inline src="/bbl-moxi/page.js"></script>
</BaseLayout>
