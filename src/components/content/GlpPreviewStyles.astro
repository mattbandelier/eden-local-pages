<style is:global>
	@font-face {
		font-family: "Eden Inter Tight";
		src: url("/fonts/inter-tight-latin.woff2") format("woff2");
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
	}
	main[data-glp-preview="true"] h1,
	main[data-glp-preview="true"] h2,
	main[data-glp-preview="true"] h3 { font-family: "Eden Inter Tight", Arial, sans-serif; letter-spacing: 0; }
	main[data-glp-preview="true"] .glp-preview-hero > div:nth-child(2) { background: linear-gradient(90deg, rgba(255,255,255,.36), rgba(255,255,255,.04)); }
	main[data-glp-preview="true"] .glp-preview-hero h1 { max-width: 610px; font-size: 60px; font-weight: 750; line-height: 1.04; color: #102422; }
	main[data-glp-preview="true"] .glp-preview-hero ul { font-size: 16px; }
	main[data-glp-preview="true"] .glp-preview-offer { border: 0; border-radius: 20px; box-shadow: 0 18px 48px rgba(16,36,34,.17); }
	main[data-glp-preview="true"] .glp-preview-offer > p:first-child { background: #e9e6f3; border: 0; color: #1b2929; }
	main[data-glp-preview="true"] .glp-preview-offer a { border-radius: 999px; background: #101716; }
	main[data-glp-preview="true"] [data-glp-benefits] { background: #fff; border: 0; padding-top: 84px; padding-bottom: 84px; }
	main[data-glp-preview="true"] [data-glp-benefits] article { border: 0; border-radius: 20px; background: #f4f7f6; box-shadow: 0 12px 32px rgba(16,36,34,.07); }
	main[data-glp-preview="true"] [data-glp-benefits] article img { aspect-ratio: 5/4; }
	main[data-glp-preview="true"] [data-glp-benefits] article:nth-child(2) { background: #eaf2fa; }
	main[data-glp-preview="true"] [data-glp-benefits] article:nth-child(3) { background: #e9f3e9; }
	main[data-glp-preview="true"] .glp-preview-start { background: #fff; padding-top: 88px; padding-bottom: 88px; }
	main[data-glp-preview="true"] .glp-preview-start [data-glp-choice] { border-width: 1px; border-radius: 16px; box-shadow: 0 10px 30px rgba(16,36,34,.07); }
	main[data-glp-preview="true"] .glp-preview-start a[data-glp-next] { border-radius: 999px; }
	main[data-glp-preview="true"] .glp-preview-pricing { background: #f3f5f5; padding-top: 92px; padding-bottom: 92px; }
	main[data-glp-preview="true"] .glp-preview-pricing-grid > div { border: 0; border-radius: 20px; box-shadow: 0 10px 30px rgba(16,36,34,.08); }
	main[data-glp-preview="true"] #lead-form { border-radius: 20px; }
	main[data-glp-preview="true"] #lead-form input,
	main[data-glp-preview="true"] #lead-form select,
	main[data-glp-preview="true"] #lead-form textarea { border-radius: 10px; }
	main[data-glp-preview="true"] #lead-form button[type="submit"] { border-radius: 999px; }
	main[data-glp-preview="true"] .glp-preview-pricing-grid h3 { background: #e5f2ea; color: #102422; font-size: 22px; }
	main[data-glp-preview="true"] .glp-preview-pricing-grid > div:nth-child(2) h3 { background: #e9e6f3; }
	main[data-glp-preview="true"] .glp-preview-pricing > div > a { border-radius: 999px; background: #101716; }
	main[data-glp-preview="true"] #care { background: #e7eee9; color: #102422; }
	main[data-glp-preview="true"] #care h2,
	main[data-glp-preview="true"] #care p { color: #102422; }
	main[data-glp-preview="true"] #care a { background: #102422; color: white; border-radius: 999px; }
	@media (max-width: 639px) {
		main[data-glp-preview="true"] .glp-preview-hero > div:nth-child(2) { background: rgba(255,255,255,.84); }
		main[data-glp-preview="true"] { display: flex; flex-direction: column; }
		main[data-glp-preview="true"] .glp-preview-hero { order: -2; }
		main[data-glp-preview="true"] .glp-preview-start { order: -1; padding-top: 32px; padding-bottom: 48px; }
		main[data-glp-preview="true"] [data-glp-start-content] { display: flex; flex-direction: column; }
		main[data-glp-preview="true"] [data-glp-form-wrap] { order: -1; width: 100%; margin-top: 0; padding-top: 0; border-top: 0; }
		main[data-glp-preview="true"] [data-glp-start-content] > :not([data-glp-form-wrap]),
		main[data-glp-preview="true"] [data-glp-proof-bar] { display: none; }
		main[data-glp-preview="true"] .glp-preview-hero h1 { font-size: 40px; line-height: 1.08; }
		main[data-glp-preview="true"] .glp-preview-pricing { padding-top: 58px; padding-bottom: 58px; }
	}
</style>
