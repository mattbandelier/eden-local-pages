---
interface Props {
	primaryLabel: string;
	ariaLabel?: string;
	desktopEyebrow?: string;
	desktopBody?: string;
}

const {
	primaryLabel,
	ariaLabel = "Contact Eden",
	desktopEyebrow = primaryLabel,
	desktopBody = "Meet with Eden in Greenwood Village and leave with a clear next step.",
} = Astro.props;
---

<aside
	data-desktop-sticky-cta
	class="pointer-events-none fixed bottom-5 right-5 z-40 hidden max-w-xs translate-y-3 rounded-lg border border-white/20 bg-eden-forest/95 p-3 text-white opacity-0 shadow-2xl backdrop-blur transition duration-200 md:block"
	aria-label={ariaLabel}
>
	<p class="text-xs font-semibold uppercase text-eden-sage">{desktopEyebrow}</p>
	<p class="mt-1 text-sm leading-5 text-white/82">{desktopBody}</p>
	<a href="#lead-form" class="mt-3 block rounded-md bg-eden-sage px-4 py-3 text-center text-sm font-semibold text-eden-forest">
		{primaryLabel}
	</a>
</aside>

<nav
	class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1fr_auto] gap-2 border-t border-eden-line bg-white/96 p-3 shadow-[0_-8px_24px_rgba(28,45,38,0.14)] backdrop-blur md:hidden"
	aria-label={ariaLabel}
>
	<a href="#lead-form" class="rounded-md bg-eden-green px-4 py-3 text-center text-sm font-semibold text-white">
		{primaryLabel}
	</a>
	<a
		href="tel:+17206057678"
		data-phone-link
		class="rounded-md border border-eden-line px-4 py-3 text-center text-sm font-semibold text-eden-navy"
	>
		Call
	</a>
</nav>

<script>
	const desktopStickyCta = document.querySelector<HTMLElement>("[data-desktop-sticky-cta]");
	const updateDesktopStickyCta = () => {
		if (!desktopStickyCta) return;
		const shouldShow = window.scrollY > window.innerHeight * 0.55;
		desktopStickyCta.classList.toggle("opacity-0", !shouldShow);
		desktopStickyCta.classList.toggle("translate-y-3", !shouldShow);
		desktopStickyCta.classList.toggle("pointer-events-none", !shouldShow);
	};

	updateDesktopStickyCta();
	window.addEventListener("scroll", updateDesktopStickyCta, { passive: true });
	window.addEventListener("resize", updateDesktopStickyCta);
</script>
