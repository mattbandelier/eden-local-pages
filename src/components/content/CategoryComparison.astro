---
interface ComparisonRow {
	label: string;
	eden: string;
	alternative: string;
}

interface Props {
	eyebrow?: string;
	heading: string;
	intro?: string;
	alternativeLabel?: string;
	rows: ComparisonRow[];
}

const {
	eyebrow = "Compare the starting point",
	heading,
	intro,
	alternativeLabel = "A less-defined path",
	rows,
} = Astro.props;
---

<section class="border-y border-eden-line bg-[#e7efe9] px-6 py-12 text-eden-forest sm:py-16">
	<div class="mx-auto max-w-6xl">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold uppercase text-eden-green">{eyebrow}</p>
			<h2 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">{heading}</h2>
			{intro && <p class="mt-4 max-w-2xl text-base leading-8 text-slate-700">{intro}</p>}
		</div>

		<div class="mt-8 hidden overflow-hidden rounded-lg border border-eden-forest/14 bg-white shadow-sm md:block">
			<div class="grid grid-cols-[0.7fr_1fr_1fr] bg-eden-forest text-sm font-semibold text-white">
				<div class="p-4 text-eden-sage">Compare</div>
				<div class="border-l border-white/15 p-4">At Eden</div>
				<div class="border-l border-white/15 p-4 text-white/76">{alternativeLabel}</div>
			</div>
			{rows.map((row) => (
				<div class="grid grid-cols-[0.7fr_1fr_1fr] border-t border-eden-line text-sm">
					<div class="bg-eden-paper p-4 font-semibold text-eden-green">{row.label}</div>
					<div class="border-l border-eden-line p-4 font-medium leading-6 text-eden-navy">{row.eden}</div>
					<div class="border-l border-eden-line p-4 leading-6 text-slate-600">{row.alternative}</div>
				</div>
			))}
		</div>

		<div class="mt-8 divide-y divide-eden-forest/14 border-y border-eden-forest/14 md:hidden">
			{rows.map((row) => (
				<div class="py-5">
					<p class="text-sm font-semibold uppercase text-eden-green">{row.label}</p>
					<div class="mt-4 border-l-2 border-eden-green pl-4">
						<p class="text-xs font-semibold uppercase text-eden-green">At Eden</p>
						<p class="mt-2 text-sm font-medium leading-6 text-eden-navy">{row.eden}</p>
					</div>
					<div class="mt-4 border-l border-eden-forest/20 pl-4">
						<p class="text-xs font-semibold uppercase text-slate-500">{alternativeLabel}</p>
						<p class="mt-2 text-sm leading-6 text-slate-600">{row.alternative}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
