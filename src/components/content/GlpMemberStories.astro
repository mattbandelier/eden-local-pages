---
const stories = [
	{
		name: "Connie",
		before: "/assets/eden-member-connie-before.webp",
		after: "/assets/eden-member-connie-after.webp",
	},
	{
		name: "Sabrina",
		before: "/assets/eden-member-sabrina-before.webp",
		after: "/assets/eden-member-sabrina-after.webp",
	},
];
---

<section aria-labelledby="member-stories-heading" class="bg-white px-6 py-14 sm:py-20">
	<div class="mx-auto max-w-6xl">
		<p class="text-xs font-semibold uppercase text-[#147e81]">Eden member stories</p>
		<h2 id="member-stories-heading" class="mt-3 max-w-2xl text-3xl font-semibold leading-tight text-eden-navy sm:text-4xl">Real people. Their own paths.</h2>
		<div class="mt-7 grid gap-6 lg:grid-cols-2">
			{stories.map((story) => <figure class="overflow-hidden rounded-md border border-[#d7e8e5] bg-[#f8fbfa]">
				<div class="grid grid-cols-2 gap-1">
					<div class="relative aspect-[4/5] overflow-hidden bg-[#e8f0ed]"><img src={story.before} alt={`${story.name} before, from her Eden Health member story`} class="h-full w-full object-cover" width="900" height="1080" loading="lazy" decoding="async" /><span class="absolute bottom-2 left-2 bg-white/95 px-2 py-1 text-xs font-semibold text-[#143c33]">Before</span></div>
					<div class="relative aspect-[4/5] overflow-hidden bg-[#e8f0ed]"><img src={story.after} alt={`${story.name} after, from her Eden Health member story`} class="h-full w-full object-cover" width="900" height="1080" loading="lazy" decoding="async" /><span class="absolute bottom-2 left-2 bg-white/95 px-2 py-1 text-xs font-semibold text-[#143c33]">After</span></div>
				</div>
				<figcaption class="px-4 py-3 text-sm font-semibold text-[#143c33]">{story.name} · Eden Health member</figcaption>
			</figure>)}
		</div>
		<p class="mt-5 max-w-4xl text-xs leading-5 text-slate-600">Eden Health member stories are from its telehealth program, separate from Eden Health Club's in-person care. Individual results vary.</p>
	</div>
</section>
