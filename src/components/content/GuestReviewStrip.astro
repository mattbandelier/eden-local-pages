---
const reviews = [
	{
		quote: "Professional, friendly, non-judgmental, down to earth.",
		context: "He also praised the clean, relaxing setting and how Eden's staff works together to create a thoughtful experience.",
		author: "Chris E.",
	},
	{
		quote: "Thorough with my lab results.",
		context: "She valued receiving clear answers, thoughtful options, and care that never felt like a sales pitch.",
		author: "Nicole K.",
	},
	{
		quote: "I never felt rushed.",
		context: "Her consultation felt personal and unrushed, with real attention given to her history, concerns, and goals.",
		author: "Amy W.",
	},
	{
		quote: "Knowledgeable and attentive.",
		context: "She highlighted clear treatment explanations, practical support, and an environment that keeps improving the guest experience.",
		author: "Kristina H.",
	},
	{
		quote: "Sat with me to hear my concerns.",
		context: "She appreciated a practitioner who listened, ordered relevant labs, and worked collaboratively toward a solution.",
		author: "Sarah K.",
	},
];
const googleMapsUrl = "https://www.google.com/maps?cid=12311342436061718588";
---

<section class="border-y border-eden-line bg-white px-6 py-4 sm:py-10" aria-label="Guest feedback" data-review-carousel>
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="text-sm font-semibold uppercase text-eden-green">Guest feedback</p>
				<p class="mt-1 text-sm leading-6 text-slate-700">What guests say about their experience at Eden.</p>
			</div>
			<div class="flex items-center gap-2 sm:gap-3">
				<a href={googleMapsUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center text-sm font-semibold text-eden-green underline underline-offset-4">
					Read guest feedback
				</a>
				<button type="button" data-review-previous aria-label="Previous review" title="Previous review" class="grid size-11 shrink-0 place-items-center rounded-full border border-eden-line text-lg text-eden-green hover:bg-eden-paper">&larr;</button>
				<button type="button" data-review-next aria-label="Next review" title="Next review" class="grid size-11 shrink-0 place-items-center rounded-full border border-eden-line text-lg text-eden-green hover:bg-eden-paper">&rarr;</button>
			</div>
		</div>
		<div data-review-track class="mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
			{reviews.map((review) => (
				<figure class="flex min-h-72 w-[min(22rem,85vw)] shrink-0 snap-start flex-col border-l-2 border-eden-sage bg-eden-paper p-5 sm:min-h-64">
					<blockquote class="text-base font-semibold leading-7 text-eden-navy">&ldquo;{review.quote}&rdquo;</blockquote>
					<p class="mt-3 text-sm leading-6 text-slate-700">{review.context}</p>
					<figcaption class="mt-auto pt-5 text-sm font-semibold text-eden-green">{review.author}</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>

<script>
	const resetInitialScroll = () => {
		if (!window.location.hash) window.scrollTo({ top: 0, left: 0, behavior: "auto" });
	};

	if ("scrollRestoration" in window.history) window.history.scrollRestoration = "manual";
	resetInitialScroll();
	window.addEventListener("pageshow", resetInitialScroll, { once: true });

	const carousels = document.querySelectorAll<HTMLElement>("[data-review-carousel]");

	carousels.forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>("[data-review-track]");
		const previous = carousel.querySelector<HTMLButtonElement>("[data-review-previous]");
		const next = carousel.querySelector<HTMLButtonElement>("[data-review-next]");
		if (!track || !previous || !next) return;

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		let timer: number | undefined;

		const cardWidth = () => {
			const firstCard = track.firstElementChild as HTMLElement | null;
			return firstCard ? firstCard.offsetWidth + 16 : track.clientWidth;
		};

		const move = (direction: 1 | -1) => {
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
			const atStart = track.scrollLeft <= 8;
			const left = direction === 1 && atEnd ? 0 : direction === -1 && atStart ? track.scrollWidth : track.scrollLeft + cardWidth() * direction;
			track.scrollTo({ left, behavior: prefersReducedMotion ? "auto" : "smooth" });
		};

		const stop = () => window.clearInterval(timer);
		const start = () => {
			if (prefersReducedMotion) return;
			stop();
			timer = window.setInterval(() => move(1), 5500);
		};

		previous.addEventListener("click", () => {
			move(-1);
			start();
		});
		next.addEventListener("click", () => {
			move(1);
			start();
		});
		carousel.addEventListener("mouseenter", stop);
		carousel.addEventListener("mouseleave", start);
		carousel.addEventListener("focusin", stop);
		carousel.addEventListener("focusout", start);
		track.addEventListener("pointerdown", stop);
		track.addEventListener("pointerup", start);

		if ("IntersectionObserver" in window) {
			const observer = new IntersectionObserver(([entry]) => {
				if (entry?.isIntersecting) start();
				else stop();
			}, { threshold: 0.25 });
			observer.observe(carousel);
		} else {
			start();
		}
	});
</script>
