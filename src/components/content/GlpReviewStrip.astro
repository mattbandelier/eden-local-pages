---
const reviews = [
	{ name: "Nick G.", context: "Comprehensive health visit", excerpt: "For the first time, I left a clinic actually understanding what was going on with my health and with a clear plan to improve it." },
	{ name: "Erika A.", context: "In-person consultation", excerpt: "They exuded professionalism while also making me feel entirely at ease throughout the entire process." },
	{ name: "Julia W.", context: "Functional health", excerpt: "Eden surpasses all expectations for a proactive functional health experience." },
];
---

<section class="border-y border-[#d7e8e5] bg-white px-6 py-10 sm:py-14" aria-labelledby="glp-reviews-heading">
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<p class="text-xs font-semibold uppercase text-[#147e81]">Guest experiences</p>
				<h2 id="glp-reviews-heading" class="mt-2 text-2xl font-semibold text-[#102422] sm:text-3xl">Real visits. Real people.</h2>
			</div>
			<a href="https://www.google.com/maps?cid=12311342436061718588" target="_blank" rel="noreferrer" class="text-sm font-semibold text-[#246747] underline underline-offset-2">Read Google reviews</a>
		</div>
		<p class="mt-3 text-sm text-[#476460]">Excerpts from guests' published reviews. <a href="https://edenhealthclubs.com/about/testimonials/" class="font-semibold underline underline-offset-2">Read the full reviews</a>.</p>
		<div class="mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3">
			{reviews.map((review) => (
				<article class="flex min-h-56 w-[min(22rem,82vw)] shrink-0 snap-start flex-col rounded-[18px] border border-[#d8e4df] bg-[#f7faf8] p-5">
					<p class="text-xs font-semibold uppercase text-[#246747]">{review.context}</p>
					<blockquote class="mt-4 text-base leading-7 text-[#193b34]">“{review.excerpt}”</blockquote>
					<p class="mt-auto pt-4 text-sm font-semibold text-[#246747]">{review.name}</p>
				</article>
			))}
		</div>
	</div>
</section>
