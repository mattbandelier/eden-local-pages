---
interface Props {
	variant?: "default" | "peptide";
}

const { variant = "default" } = Astro.props;
const isPeptide = variant === "peptide";

const reviews = [
	{ name: "Nick G.", context: "Comprehensive health visit", excerpt: "For the first time, I left a clinic actually understanding what was going on with my health and with a clear plan to improve it." },
	{ name: "Erika A.", context: "In-person consultation", excerpt: "They exuded professionalism while also making me feel entirely at ease throughout the entire process." },
	{ name: "Julia W.", context: "Functional health", excerpt: "Eden surpasses all expectations for a proactive functional health experience." },
];
---

<section data-review-strip={variant} class={isPeptide ? "border-y border-[#d7e8e5] bg-[#e9f2e9] px-6 py-9 sm:py-12" : "border-y border-[#d7e8e5] bg-white px-6 py-10 sm:py-14"} aria-labelledby="glp-reviews-heading">
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<p class="text-xs font-semibold uppercase text-[#147e81]">Guest experiences</p>
				<h2 id="glp-reviews-heading" class="mt-2 text-2xl font-semibold text-[#102422] sm:text-3xl">Real visits. Real people.</h2>
			</div>
			<a href="https://www.google.com/maps?cid=12311342436061718588" target="_blank" rel="noreferrer" class="text-sm font-semibold text-[#246747] underline underline-offset-2">Read Google reviews</a>
		</div>
		{!isPeptide && <p class="mt-3 text-sm text-[#476460]">Excerpts from guests' published reviews. <a href="https://edenhealthclubs.com/about/testimonials/" class="font-semibold underline underline-offset-2">Read the full reviews</a>.</p>}
		<div data-review-track class={isPeptide ? "mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" : "mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3"}>
			{reviews.map((review, index) => (
				<article class={isPeptide ? `flex min-h-52 w-[min(21rem,82vw)] shrink-0 snap-start flex-col rounded-[20px] border border-[#d6e4d8] p-5 shadow-[0_10px_28px_rgba(16,36,34,0.06)] sm:w-[23rem] ${index === 1 ? "bg-[#fffaf2]" : "bg-white"}` : "flex min-h-56 w-[min(22rem,82vw)] shrink-0 snap-start flex-col rounded-[18px] border border-[#d8e4df] bg-[#f7faf8] p-5"}>
					{isPeptide && <span aria-hidden="true" class="h-8 text-5xl leading-none text-[#83aa8f]">“</span>}
					<p class={isPeptide ? "mt-2 text-[11px] font-semibold uppercase text-[#246747]" : "text-xs font-semibold uppercase text-[#246747]"}>{review.context}</p>
					<blockquote class={isPeptide ? "mt-3 text-base font-medium leading-7 text-[#193b34]" : "mt-4 text-base leading-7 text-[#193b34]"}>{isPeptide ? review.excerpt : `“${review.excerpt}”`}</blockquote>
					<p class="mt-auto pt-4 text-sm font-semibold text-[#246747]">{review.name}</p>
				</article>
			))}
		</div>
		{isPeptide && <div class="mt-2 flex items-center justify-between gap-4">
			<p class="text-xs leading-5 text-[#476460]">Excerpts from guests' published reviews. <a href="https://edenhealthclubs.com/about/testimonials/" class="font-semibold underline underline-offset-2">Read the full reviews</a>.</p>
			<div class="flex shrink-0 gap-2 xl:hidden">
				<button type="button" data-review-previous aria-label="Previous review" title="Previous review" class="grid size-10 place-items-center rounded-full border border-[#9dbda8] bg-white text-lg text-[#174a3b] transition hover:bg-[#f4f9f2]">&larr;</button>
				<button type="button" data-review-next aria-label="Next review" title="Next review" class="grid size-10 place-items-center rounded-full border border-[#9dbda8] bg-white text-lg text-[#174a3b] transition hover:bg-[#f4f9f2]">&rarr;</button>
			</div>
		</div>}
	</div>
</section>

<script>
	const strip = document.querySelector<HTMLElement>('[data-review-strip="peptide"]');
	const track = strip?.querySelector<HTMLElement>('[data-review-track]');
	if (strip && track) {
		for (const [selector, direction] of [['[data-review-previous]', -1], ['[data-review-next]', 1]] as const) {
			strip.querySelector<HTMLButtonElement>(selector)?.addEventListener('click', () => {
				const card = track.querySelector<HTMLElement>('article');
				if (card) track.scrollBy({ left: direction * (card.offsetWidth + 16), behavior: 'smooth' });
			});
		}
	}
</script>
