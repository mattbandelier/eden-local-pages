---
const reviews = [
	{ name: "Nick G.", summary: "The team took time to explain his lab results marker by marker and gave him a clear plan." },
	{ name: "Gustavo M.", summary: "He describes Christina as approachable and professional during his visit." },
	{ name: "Erika A.", summary: "Christina listened to her concerns, answered questions, and helped her feel informed before treatment." },
	{ name: "Kat C.", summary: "She highlights a kind, knowledgeable front-desk team and a welcoming experience." },
	{ name: "Julia W.", summary: "She describes an attentive team and a clean, well-equipped space for functional health and fitness." },
];
---

<section class="border-y border-[#d7e8e5] bg-white px-6 py-10 sm:py-14" aria-labelledby="glp-reviews-heading">
	<div class="mx-auto max-w-6xl">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<p class="text-xs font-semibold uppercase text-[#147e81]">Guest experiences</p>
				<h2 id="glp-reviews-heading" class="mt-2 text-2xl font-semibold text-[#102422] sm:text-3xl">Real visits. Real people.</h2>
			</div>
			<a href="https://www.google.com/maps?cid=12311342436061718588" target="_blank" rel="noreferrer" class="text-sm font-semibold text-[#246747] underline underline-offset-2">Read Google reviews</a>
		</div>
		<p class="mt-3 text-sm text-[#476460]">Highlights paraphrased from guest reviews; individual experiences vary.</p>
		<div class="mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3">
			{reviews.map((review) => (
				<article class="flex min-h-48 w-[min(20rem,82vw)] shrink-0 snap-start flex-col rounded-md border border-[#d8e4df] bg-[#f7faf8] p-5">
					<p class="text-base leading-7 text-[#193b34]">{review.summary}</p>
					<p class="mt-auto pt-4 text-sm font-semibold text-[#246747]">{review.name}</p>
				</article>
			))}
		</div>
	</div>
</section>
