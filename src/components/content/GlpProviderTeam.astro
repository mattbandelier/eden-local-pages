---
const providers = [
	{
		name: "Cat Hosteny, MSN, APRN, FNP-BC",
		role: "Family Nurse Practitioner",
		focus: "A collaborative approach to longevity and wellness care.",
		image: "/assets/glp-provider-cat-light.webp",
	},
	{
		name: "Mya Sedillo, FNP-C",
		role: "Family Nurse Practitioner",
		focus: "Experience in medical weight loss and whole-person wellness.",
		image: "/assets/glp-provider-mya-light.webp",
	},
	{
		name: "Katie Morrison, MMS, PA-C",
		role: "Physician Associate",
		focus: "A background in medical weight management and metabolic health.",
		image: "/assets/glp-provider-katie-light.webp",
	},
];
---

<section class="bg-white px-6 py-14 sm:py-20" aria-labelledby="glp-provider-heading">
	<div class="mx-auto max-w-6xl">
		<p class="text-xs font-semibold uppercase text-[#147e81]">The people behind your care</p>
		<h2 id="glp-provider-heading" class="mt-3 text-3xl font-semibold text-[#102422] sm:text-4xl">Meet Eden's care team.</h2>
		<p class="mt-3 max-w-2xl text-base leading-7 text-[#284b49]">Your first visit is a conversation with a licensed provider about your history, goals, and options.</p>
		<div class="mt-8 grid gap-5 sm:grid-cols-3">
			{providers.map((provider) => (
				<article class="overflow-hidden rounded-md bg-white">
					<img src={provider.image} alt={provider.name} class="aspect-[4/5] w-full object-cover object-top" width="450" height="562" loading="lazy" decoding="async" />
					<div class="p-5">
						<h3 class="text-lg font-semibold leading-snug text-[#102422]">{provider.name}</h3>
						<p class="mt-1 text-sm font-medium text-[#246747]">{provider.role}</p>
						<p class="mt-3 text-sm leading-6 text-[#476460]">{provider.focus}</p>
					</div>
				</article>
			))}
		</div>
		<p class="mt-5 text-sm text-[#476460]">Your clinician depends on availability and clinical needs. <a href="https://edenhealthclubs.com/about/meet-the-team/" class="font-semibold underline underline-offset-2">Meet the full team</a>.</p>
	</div>
</section>
